{
  "requested_model": "kimi-k3",
  "max_tokens": 1000000,
  "at": "2026-10-19T16:40:38+08:00",
  "text": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"UTF-8\">\n<title>裂刃试炼 · 战斗试玩</title>\n<style>\n  html,body{margin:0;padding:0;background:#0a0a12;height:100%;overflow:hidden;font-family:\"Segoe UI\",Arial,sans-serif;}\n  #wrap{position:relative;width:100vw;height:100vh;display:flex;align-items:center;justify-content:center;}\n  canvas{background:#111;border:1px solid #2a2a44;box-shadow:0 0 40px #000;}\n  .btn{position:absolute;padding:6px 14px;background:#1c1c2e;color:#cfd2ff;border:1px solid #4a4a80;cursor:pointer;font-size:14px;border-radius:4px;z-index:5;}\n  .btn:hover{background:#2c2c48;}\n  #muteBtn{top:10px;right:10px;}\n  #overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:rgba(8,8,16,0.88);z-index:10;color:#e8e8ff;text-align:center;}\n  #overlay h1{font-size:42px;margin:0 0 8px;letter-spacing:6px;color:#ffd27d;text-shadow:0 0 20px #ff9d3c;}\n  #overlay p{margin:4px;color:#9fa3d0;}\n  #startBtn{margin-top:18px;font-size:18px;padding:10px 34px;background:#3a2a10;color:#ffd27d;border:1px solid #ff9d3c;}\n  #startBtn:hover{background:#5a421c;}\n  .keys{display:grid;grid-template-columns:auto auto;gap:2px 14px;margin-top:14px;font-size:14px;color:#b9bce8;text-align:left;}\n  .keys b{color:#ffd27d;}\n</style>\n</head>\n<body>\n<div id=\"wrap\">\n  <canvas id=\"cv\" width=\"960\" height=\"540\"></canvas>\n  <button class=\"btn\" id=\"muteBtn\">🔊 音效</button>\n  <div id=\"overlay\">\n    <h1>裂 刃 试 炼</h1>\n    <p>斩断魔像与猎犬 —— 重击可撕裂它们的肢体</p>\n    <div class=\"keys\">\n      <span><b>A / D</b></span><span>移动</span>\n      <span><b>Space</b></span><span>跳跃</span>\n      <span><b>J</b></span><span>连斩（三连，可在硬直中衔接）</span>\n      <span><b>K</b></span><span>蓄力重斩（松开释放，断肢）</span>\n      <span><b>L</b></span><span>疾冲（无敌帧）</span>\n      <span><b>I</b></span><span>弹反（敌人出手瞬间招架）</span>\n      <span><b>R</b></span><span>重新开始</span>\n    </div>\n    <button class=\"btn\" id=\"startBtn\">开 始 战 斗 (Enter)</button>\n  </div>\n</div>\n<script>\n\"use strict\";\n// ---------- 基础 ----------\nconst cv=document.getElementById('cv'),ctx=cv.getContext('2d');\nconst W=960,H=540,GY=470,WORLD_W=1700;\nfunction fit(){const s=Math.min(innerWidth/W,innerHeight/H)*0.98;cv.style.width=(W*s)+'px';cv.style.height=(H*s)+'px';}\naddEventListener('resize',fit);fit();\n// ---------- 音频 ----------\nlet AC=null,muted=false,noiseBuf=null;\nfunction initAudio(){if(AC)return;try{AC=new (window.AudioContext||window.webkitAudioContext)();noiseBuf=AC.createBuffer(1,AC.sampleRate*0.4,AC.sampleRate);const d=noiseBuf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1;}catch(e){}}\nfunction tone(f0,f1,dur,type,vol){if(!AC||muted)return;try{const t=AC.currentTime,o=AC.createOscillator(),g=AC.createGain();o.type=type;o.frequency.setValueAtTime(f0,t);o.frequency.exponentialRampToValueAtTime(Math.max(20,f1),t+dur);g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.001,t+dur);o.connect(g).connect(AC.destination);o.start(t);o.stop(t+dur+0.02);}catch(e){}}\nfunction nz(dur,vol,f0,f1){if(!AC||muted)return;try{const t=AC.currentTime,s=AC.createBufferSource();s.buffer=noiseBuf;const f=AC.createBiquadFilter();f.type='bandpass';f.frequency.setValueAtTime(f0,t);f.frequency.exponentialRampToValueAtTime(Math.max(30,f1),t+dur);f.Q.value=1;const g=AC.createGain();g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(0.001,t+dur);s.connect(f).connect(g).connect(AC.destination);s.start(t);s.stop(t+dur+0.02);}catch(e){}}\nfunction sfx(n){switch(n){\n case 'swing':nz(0.12,0.18,2400,400);break;\n case 'hit':tone(190,60,0.12,'square',0.22);nz(0.08,0.15,900,200);break;\n case 'heavy':tone(120,35,0.25,'sawtooth',0.3);nz(0.18,0.22,600,80);break;\n case 'dash':nz(0.16,0.14,300,2000);break;\n case 'jump':tone(260,560,0.12,'sine',0.12);break;\n case 'hurt':tone(300,90,0.2,'sawtooth',0.2);break;\n case 'parry':tone(1400,900,0.18,'square',0.18);tone(2100,1500,0.22,'triangle',0.14);break;\n case 'brk':nz(0.2,0.3,700,90);tone(90,35,0.25,'square',0.25);break;\n case 'die':tone(160,30,0.4,'sawtooth',0.25);nz(0.3,0.2,500,60);break;\n case 'charge':tone(80,320,0.5,'sine',0.08);break;\n}}\ndocument.getElementById('muteBtn').addEventListener('click',function(){initAudio();muted=!muted;this.textContent=muted?'🔇 静音':'🔊 音效';});\n// ---------- 输入 ----------\nconst keys={},pressed={};\nconst GK=['KeyA','KeyD','ArrowLeft','ArrowRight','Space','KeyJ','KeyK','KeyL','KeyI','KeyR','Enter'];\naddEventListener('keydown',e=>{\n  if(GK.indexOf(e.code)>=0)e.preventDefault();\n  initAudio();if(AC&&AC.state==='suspended')AC.resume();\n  if(!e.repeat){keys[e.code]=true;pressed[e.code]=true;}\n  if(e.code==='Enter'&&!game.playing)startGame();\n});\naddEventListener('keyup',e=>{keys[e.code]=false;});\naddEventListener('blur',()=>{for(const k in keys)keys[k]=false;});\ndocument.getElementById('startBtn').addEventListener('click',()=>{initAudio();startGame();});\n// ---------- 状态 ----------\nconst game={ready:true,playing:false,wave:1,spawnT:0,hitCount:0,limbBreaks:0,freeze:0,shake:0,shakeX:0,shakeY:0,camX:0,slowmo:0,flash:0};\nlet player,enemies,parts,fx,after;\nfunction mkParts(type){\n  if(type==='hound')return[\n    {n:'head',ox:20,oy:-46,w:22,h:16,hp:18,limb:false,broken:false,c:'#7d3b3b'},\n    {n:'body',ox:0,oy:-30,w:44,h:24,hp:40,limb:false,broken:false,c:'#8f4444'},\n    {n:'legF',ox:14,oy:-8,w:10,h:22,hp:14,limb:true,broken:false,c:'#6e3333'},\n    {n:'legB',ox:-14,oy:-8,w:10,h:22,hp:14,limb:true,broken:false,c:'#6e3333'}];\n  return[\n    {n:'head',ox:0,oy:-88,w:22,h:18,hp:26,limb:false,broken:false,c:'#5d6f8f'},\n    {n:'body',ox:0,oy:-52,w:46,h:52,hp:70,limb:false,broken:false,c:'#4a5a78'},\n    {n:'armL',ox:-30,oy:-56,w:16,h:44,hp:26,limb:true,broken:false,c:'#3d4c66'},\n    {n:'armR',ox:30,oy:-56,w:16,h:44,hp:26,limb:true,broken:false,c:'#3d4c66'}];\n}\nfunction spawnEnemy(type,x){\n  const golem=type==='golem';\n  enemies.push({type,x,y:GY,vx:0,vy:0,face:x<player.x?1:-1,\n    hp:golem?120:60,maxHp:golem?120:60,\n    state:'chase',t:0,strikeDone:false,flashT:0,airborne:false,\n    parts:mkParts(type),dead:false,deadT:0,atkCd:0});\n}\nfunction startGame(){\n  document.getElementById('overlay').style.display='none';\n  player={x:400,y:GY,vx:0,vy:0,face:1,hp:100,maxHp:100,state:'idle',t:0,onGround:true,\n    atk:null,queued:false,charge:0,dashT:0,ifr:0,hurtT:0,parryT:0,combo:0,comboT:0,swingId:0};\n  enemies=[];parts=[];fx=[];after=[];\n  game.wave=1;game.hitCount=0;game.limbBreaks=0;game.freeze=0;game.shake=0;game.slowmo=0;game.flash=0;\n  game.playing=true;game.spawnT=0;\n  spawnEnemy('hound',900);spawnEnemy('hound',1300);spawnEnemy('golem',1500);\n}\n// ---------- 攻击数据 ----------\nconst COMBO=[\n {dur:0.26,hit:0.10,range:64,dmg:9,kb:4,hs:0.05,launch:0,ang:-0.9},\n {dur:0.26,hit:0.11,range:68,dmg:10,kb:5,hs:0.06,launch:0,ang:0.9},\n {dur:0.34,hit:0.14,range:74,dmg:16,kb:9,hs:0.10,launch:-6,ang:-1.3}];\n// ---------- 粒子 ----------\nfunction spark(x,y,n,c,spd){for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,s=(Math.random()*0.7+0.3)*spd;fx.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-2,life:0.3+Math.random()*0.2,t:0,c,r:1+Math.random()*2.5});}}\nfunction limbFly(p,e,big){\n  const wx=e.x+p.ox*e.face,wy=e.y+p.oy;\n  parts.push({x:wx,y:wy,w:p.w,h:p.h,c:p.c,vx:e.face*(1+Math.random()*3)+(Math.random()-0.5)*3,\n    vy:-(4+Math.random()*(big?7:4)),rot:Math.random()*6,vr:(Math.random()-0.5)*0.5,life:1.6,t:0});\n}\n// ---------- 伤害 ----------\nfunction damageEnemy(e,dmg,dir,kb,hs,launch,heavy){\n  e.hp-=dmg;e.flashT=0.12;\n  game.hitCount++;player.combo++;player.comboT=2.2;\n  game.freeze=Math.max(game.freeze,hs);\n  game.shake=Math.min(14,game.shake+dmg*0.35+(heavy?4:0));\n  spark(e.x+dir*10,e.y-40,heavy?16:8,heavy?'#ffd27d':'#ffe9a8',heavy?9:6);\n  // 肢体伤害\n  const intact=e.parts.filter(p=>!p.broken);\n  let target=null;\n  if(heavy){const limbs=intact.filter(p=>p.limb);target=limbs.length?limbs[Math.floor(Math.random()*limbs.length)]:(intact.filter(p=>p.n==='head')[0]||intact[0]);}\n  else target=intact[Math.floor(Math.random()*intact.length)];\n  if(target){target.hp-=dmg;\n    if(target.hp<=0&&!target.broken){\n      if(target.limb){target.broken=true;game.limbBreaks++;limbFly(target,e,heavy);sfx('brk');\n        spark(e.x+target.ox*e.face,e.y+target.oy,14,'#ff6b5e',8);\n        if(e.type==='golem'){const arms=e.parts.filter(p=>p.limb&&!p.broken).length;if(arms===0)e.hp-=15;}\n      } else target.hp=Math.max(6,target.hp*0.5+6);\n    }}\n  e.vx=dir*kb;if(launch&&e.onGround!==false&&e.type==='hound'){e.vy=launch;e.airborne=true;}\n  if(e.type==='golem'){e.vx*=0.3;if(e.state!=='windup'||heavy){e.state='stagger';e.t=heavy?0.7:0.3;}}\n  else {e.state='stagger';e.t=heavy?0.6:0.25;}\n  sfx(heavy?'heavy':'hit');\n  if(e.hp<=0)killEnemy(e);\n}\nfunction killEnemy(e){\n  e.dead=true;e.deadT=1.2;sfx('die');\n  e.parts.forEach(p=>{if(!p.broken)limbFly(p,e,true);});\n  spark(e.x,e.y-40,26,'#ff9d3c',10);\n  game.shake=Math.min(16,game.shake+6);game.freeze=Math.max(game.freeze,0.12);\n}\nfunction hurtPlayer(dmg,dir){\n  if(player.ifr>0||player.dashT>0)return;\n  if(player.parryT>0){ // 弹反成功\n    sfx('parry');game.freeze=0.28;game.slowmo=0.5;game.flash=0.25;\n    spark(player.x+player.face*20,player.y-40,24,'#9df2ff',10);\n    enemies.forEach(e=>{if(!e.dead&&Math.abs(e.x-player.x)<160){e.state='stagger';e.t=1.6;e.vx=dir*8;}});\n    player.parryT=0;player.state='idle';player.ifr=0.6;return;\n  }\n  player.hp-=dmg;player.hurtT=0.5;player.ifr=0.9;player.state='hurt';player.t=0;\n  player.vx=dir*6;player.vy=-3;player.atk=null;player.charge=0;\n  game.shake=Math.min(12,game.shake+5);game.freeze=Math.max(game.freeze,0.06);\n  spark(player.x,player.y-40,10,'#ff5e5e',7);sfx('hurt');\n  if(player.hp<=0){player.hp=0;player.state='dead';game.playing=false;\n    setTimeout(()=>{document.getElementById('overlay').style.display='flex';\n      document.getElementById('overlay').querySelector('h1').textContent='阵 亡';\n      document.getElementById('startBtn').textContent='再 战 (Enter / R)';},900);}\n}\n// ---------- 更新 ----------\nfunction startSwing(i){\n  player.swingId++;\n  player.atk={i,t:0,hitDone:false,id:player.swingId};\n  player.state='attack';player.t=0;sfx('swing');\n}\nfunction releaseHeavy(){\n  const c=Math.min(1,player.charge/0.9);\n  player.atk={i:99,t:0,hitDone:false,id:++player.swingId,heavy:true,pow:c};\n  player.state='attack';player.t=0;player.charge=0;sfx('swing');\n}\nfunction updPlayer(dt){\n  const p=player,L=keys.KeyA||keys.ArrowLeft,R=keys.KeyD||keys.ArrowRight;\n  p.t+=dt;if(p.ifr>0)p.ifr-=dt;if(p.comboT>0){p.comboT-=dt;if(p.comboT<=0)p.combo=0;}\n  if(p.state==='dead')return;\n  // 弹反\n  if(pressed.KeyI&&p.state!=='attack'&&p.dashT<=0&&p.hurtT<=0){p.parryT=0.22;p.state='parry';p.t=0;sfx('dash');}\n  if(p.state==='parry'){p.parryT-=dt;if(p.t>0.35)p.state='idle';}\n  // 疾冲\n  if(pressed.KeyL&&p.dashT<=0&&p.hurtT<=0&&p.state!=='charging'){\n    p.dashT=0.22;p.state='dash';p.vx=p.face*14;sfx('dash');\n    after.push({x:p.x,y:p.y,face:p.face,t:0.25});\n  }\n  if(p.dashT>0){p.dashT-=dt;p.x+=p.vx;if(p.dashT<=0){p.state='idle';p.vx=0;}p.x=Math.max(30,Math.min(WORLD_W-30,p.x));return;}\n  // 攻击推进\n  if(p.state==='attack'&&p.atk){\n    const a=p.atk,dat=a.heavy?{dur:0.42,hit:0.16,range:86+40*a.pow}:COMBO[a.i];\n    if(a.t>=dat.hit&&!a.hitDone){\n      a.hitDone=true;\n      enemies.forEach(e=>{\n        if(e.dead)return;\n        const dx=e.x-p.x,inR=Math.abs(dx)<dat.range+22&&Math.sign(dx||p.face)===p.face,dy=Math.abs((e.y-40)-(p.y-40))<70;\n        if(inR&&dy){\n          if(a.heavy)damageEnemy(e,20+26*a.pow,p.face,10+8*a.pow,0.14+0.1*a.pow,-9,true);\n          else damageEnemy(e,dat.dmg,p.face,dat.kb,dat.hs,dat.launch,false);\n        }});\n    }\n    if(a.t>=dat.dur){\n      if(p.queued&&!a.heavy&&a.i<2){p.queued=false;startSwing(a.i+1);}\n      else{p.atk=null;p.state='idle';p.queued=false;}\n    }\n    if(pressed.KeyJ&&a.t>dat.hit)p.queued=true;\n    p.x+=p.face*(a.heavy?1.2:1.6)*dt*8;\n  }\n  // 蓄力\n  if(p.state==='charging'){\n    if(keys.KeyK){p.charge+=dt;if(Math.random()<dt*8)spark(p.x+p.face*18,p.y-50,1,'#ffd27d',3);}\n    else releaseHeavy();\n  } else if(pressed.KeyK&&p.state!=='attack'&&p.hurtT<=0&&p.onGround){p.state='charging';p.charge=0;sfx('charge');}\n  // 普通攻击\n  if(pressed.KeyJ&&p.state!=='attack'&&p.state!=='charging'&&p.hurtT<=0)startSwing(0);\n  // 移动\n  if(p.state!=='attack'&&p.state!=='charging'&&p.state!=='parry'&&p.hurtT<=0){\n    const mv=(R?1:0)-(L?1:0);\n    p.vx=mv*5;if(mv)p.face=mv;\n    p.state=p.onGround?(mv?'run':'idle'):'air';\n  }\n  if(pressed.Space&&p.onGround&&p.hurtT<=0){p.vy=-11.5;p.onGround=false;sfx('jump');}\n  if(p.hurtT>0)p.hurtT-=dt;\n  // 重力\n  p.vy+=0.55;p.y+=p.vy;p.x+=p.vx;\n  if(p.y>=GY){if(!p.onGround&&p.vy>6)spark(p.x,GY,5,'#8a8aa8',3);p.y=GY;p.vy=0;p.onGround=true;}\n  p.x=Math.max(30,Math.min(WORLD_W-30,p.x));\n}\nfunction enemyHitbox(e){return{x:e.x-24,y:e.y-(e.type==='golem'?96:52),w:48,h:e.type==='golem'?96:52};}\nfunction updEnemy(e,dt){\n  if(e.dead){e.deadT-=dt;return;}\n  e.t+=dt;e.flashT=Math.max(0,e.flashT-dt);e.atkCd=Math.max(0,e.atkCd-dt);\n  e.vy+=0.55;e.y+=e.vy;\n  if(e.y>=GY){if(e.airborne){spark(e.x,GY,6,'#8a8aa8',4);}e.y=GY;e.vy=0;e.airborne=false;}\n  const dx=player.x-e.x,adx=Math.abs(dx),dir=Math.sign(dx)||1;\n  const legs=e.parts.filter(p=>p.n.indexOf('leg')===0&&!p.broken).length;\n  const arms=e.parts.filter(p=>p.n.indexOf('arm')===0&&!p.broken).length;\n  const speedMul=e.type==='hound'?(legs===0?0.35:legs===1?0.65:1):1;\n  switch(e.state){\n   case 'chase':\n    e.face=dir;\n    if(e.type==='hound'){\n      if(adx>60)e.vx=dir*3.2*speedMul;else e.vx=0;\n      if(adx<85&&e.atkCd<=0){e.state='windup';e.t=0;e.vx=0;}\n    }else{\n      if(adx>80)e.vx=dir*1.5;else e.vx=0;\n      if(adx<(arms>0?110:60)&&e.atkCd<=0){e.state='windup';e.t=0;e.vx=0;}\n    }\n    break;\n   case 'windup':\n    e.vx=0;\n    if(e.t>(e.type==='hound'?0.45:0.75)){e.state='strike';e.t=0;e.strikeDone=false;sfx('swing');\n      if(e.type==='hound'){e.vx=e.face*9;e.vy=-2;}}\n    break;\n   case 'strike':\n    if(e.type==='hound'){\n      e.x+=e.vx;\n      if(!e.strikeDone&&adx<60&&Math.abs(player.y-e.y)<60){e.strikeDone=true;hurtPlayer(12,e.face);}\n      if(e.t>0.3){e.state='recover';e.t=0;e.vx=0;}\n    }else{\n      if(!e.strikeDone&&e.t>0.08){\n        e.strikeDone=true;game.shake=Math.min(12,game.shake+4);\n        spark(e.x+e.face*50,GY,10,'#8a8aa8',5);nz&&sfx('heavy');\n        const reach=arms>0?95:50,dmg=arms===2?20:arms===1?13:7;\n        if(player.x>e.x-20&&Math.abs(player.x-(e.x+e.face*reach*0.6))<reach*0.7&&player.y>GY-90)hurtPlayer(dmg,e.face);\n      }\n      if(e.t>0.3){e.state='recover';e.t=0;}\n    }\n    break;\n   case 'recover':e.vx=0;if(e.t>(e.type==='hound'?0.5:0.9)){e.state='chase';e.atkCd=e.type==='hound'?0.6:1.4;}break;\n   case 'stagger':e.vx*=0.85;if(e.t<=0)e.state='chase';else e.t-=dt*0;{if(e.t>0)e.t-=dt;else e.state='chase';}break;\n  }\n  if(e.state!=='strike'||e.type!=='hound')e.x+=e.vx*(e.state==='stagger'?0.5:1)*dt*60/60;\n  e.x=Math.max(30,Math.min(WORLD_W-30,e.x));\n}\n// ---------- 主循环 ----------\nlet last=performance.now();\nfunction loop(now){\n  requestAnimationFrame(loop);\n  let dt=Math.min(0.033,(now-last)/1000);last=now;\n  if(game.slowmo>0){game.slowmo-=dt;dt*=0.35;}\n  if(game.freeze>0){game.freeze-=dt;render();return;}\n  if(game.playing||player){\n    if(game.playing){\n      updPlayer(dt);\n      enemies.forEach(e=>updEnemy(e,dt));\n      enemies=enemies.filter(e=>!e.dead||e.deadT>0);\n      // 刷新\n      const alive=enemies.filter(e=>!e.dead).length;\n      if(alive===0){game.spawnT-=dt;\n        if(game.spawnT<=0){game.wave++;\n          const n=Math.min(2+game.wave,5);\n          for(let i=0;i<n;i++){const side=Math.random()<0.5?-1:1;\n            spawnEnemy(i%3===2?'golem':'hound',Math.max(60,Math.min(WORLD_W-60,player.x+side*(400+Math.random()*400))));}\n          game.spawnT=1.2;}\n      }\n    }\n    // 粒子\n    fx.forEach(f=>{f.t+=dt;f.x+=f.vx;f.y+=f.vy;f.vy+=0.3;});fx=fx.filter(f=>f.t<f.life);\n    parts.forEach(p=>{p.t+=dt;p.vy+=0.5;p.x+=p.vx;p.y+=p.vy;p.rot+=p.vr;\n      if(p.y>GY){p.y=GY;p.vy*=-0.4;p.vx*=0.7;p.vr*=0.5;}});\n    parts=parts.filter(p=>p.t<p.life);\n    after.forEach(a=>a.t-=dt);after=after.filter(a=>a.t>0);\n    // 相机\n    const tx=Math.max(0,Math.min(WORLD_W-W,player.x-W/2));\n    game.camX+=(tx-game.camX)*0.12;\n    game.shake*=0.86;game.flash=Math.max(0,game.flash-dt);\n    game.shakeX=(Math.random()-0.5)*game.shake;game.shakeY=(Math.random()-0.5)*game.shake;\n  }\n  if(pressed.KeyR){startGame();}\n  for(const k in pressed)pressed[k]=false;\n  render();\n}\nrequestAnimationFrame(loop);\n// ---------- 绘制 ----------\nfunction drawPlayerFig(x,y,face,pose,alpha){\n  ctx.save();ctx.translate(x,y);ctx.scale(face,1);ctx.globalAlpha=alpha;\n  const p=player;\n  // 腿\n  ctx.strokeStyle='#2b2b3d';ctx.lineWidth=5;ctx.lineCap='round';\n  const run=pose==='run'?Math.sin(p.t*14)*7:0;\n  ctx.beginPath();ctx.moveTo(0,-24);ctx.lineTo(-6+run,0);ctx.moveTo(0,-24);ctx.lineTo(6-run,0);ctx.stroke();\n  // 身体\n  ctx.fillStyle='#3d3d5c';ctx.fillRect(-8,-48,16,26);\n  ctx.fillStyle='#ffd27d';ctx.fillRect(-8,-48,16,4);\n  // 头\n  ctx.fillStyle='#e8d5b0';ctx.beginPath();ctx.arc(2,-56,8,0,7);ctx.fill();\n  ctx.fillStyle='#222';ctx.fillRect(4,-59,4,3);\n  // 剑\n  let ang=-0.5,reach=38;\n  if(p.state==='attack'&&p.atk&&alpha===1){\n    const a=p.atk;\n    if(a.heavy){const pr=Math.min(1,a.t/0.16);ang=2.2-pr*3.4;reach=44+26*a.pow;}\n    else{const dat=COMBO[a.i],pr=Math.min(1,a.t/dat.dur);ang=dat.ang>0?(-1.8+pr*2.8):(1.4-pr*2.8);}\n  } else if(p.state==='charging'&&alpha===1){ang=2.4;reach=44;}\n  else if(p.state==='parry'&&alpha===1){ang=-1.4;}\n  ctx.save();ctx.translate(4,-40);ctx.rotate(ang);\n  ctx.fillStyle='#cfd2ff';ctx.fillRect(0,-3,reach,5);\n  ctx.fillStyle='#8a6d3b';ctx.fillRect(-6,-5,8,9);\n  ctx.restore();\n  // 蓄力光环\n  if(p.state==='charging'&&alpha===1){const c=Math.min(1,p.charge/0.9);\n    ctx.strokeStyle='rgba(255,210,125,'+(0.4+c*0.6)+')';ctx.lineWidth=2;\n    ctx.beginPath();ctx.arc(0,-36,18+c*14,0,7);ctx.stroke();}\n  // 弹反闪光\n  if(p.state==='parry'&&p.parryT>0&&alpha===1){\n    ctx.strokeStyle='rgba(157,242,255,0.9)';ctx.lineWidth=3;\n    ctx.beginPath();ctx.arc(10,-40,22,-1.2,1.2);ctx.stroke();}\n  ctx.restore();\n}\nfunction drawEnemy(e){\n  const bob=e.state==='chase'?Math.sin(e.t*8)*2:0;\n  ctx.save();ctx.translate(e.x,bob);ctx.scale(e.face,1);\n  const wind=e.state==='windup';\n  if(wind&&Math.floor(e.t*12)%2===0){ctx.shadowColor='#ff3b3b';ctx.shadowBlur=18;}\n  const stg=e.state==='stagger'?Math.sin(e.t*40)*3:0;\n  ctx.translate(stg,0);\n  e.parts.forEach(p=>{\n    if(p.broken)return;\n    ctx.fillStyle=e.flashT>0?'#ffffff':p.c;\n    if(e.type==='golem'&&p.n.indexOf('arm')===0&&e.state==='windup'){\n      ctx.save();ctx.translate(p.ox,p.oy);ctx.rotate(-e.t*2.2);ctx.fillRect(-p.w/2,0,p.w,p.h);ctx.restore();\n    } else if(e.type==='golem'&&p.n.indexOf('arm')===0&&e.state==='strike'){\n      ctx.save();ctx.translate(p.ox,p.oy);ctx.rotate(1.4);ctx.fillRect(-p.w/2,0,p.w,p.h);ctx.restore();\n    } else ctx.fillRect(p.ox-p.w/2,p.oy-p.h/2,p.w,p.h);\n  });\n  // 眼睛\n  ctx.fillStyle=wind?'#ff3b3b':'#ffb13b';\n  ctx.fillRect(e.type==='golem'?2:16,e.type==='golem'?-86:-46,6,4);\n  ctx.restore();ctx.shadowBlur=0;\n  // 血条\n  if(!e.dead){ctx.fillStyle='#222';ctx.fillRect(e.x-24,e.y-(e.type==='golem'?112:66),48,5);\n    ctx.fillStyle='#e04b4b';ctx.fillRect(e.x-23,e.y-(e.type==='golem'?111:65),46*Math.max(0,e.hp/e.maxHp),3);}\n}\nfunction render(){\n  ctx.clearRect(0,0,W,H);\n  const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#141428');g.addColorStop(0.7,'#1c1633');g.addColorStop(1,'#241a2e');\n  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);\n  ctx.save();ctx.translate(-game.camX+game.shakeX,game.shakeY);\n  // 远景\n  ctx.fillStyle='#1a1a30';\n  for(let i=0;i<10;i++){const bx=i*200-((game.camX*0.3)%200);ctx.fillRect(bx,180+(i%3)*40,60,300);}\n  ctx.fillStyle='#0f0f1e';\n  for(let i=0;i<12;i++){const bx=i*160-((game.camX*0.6)%160);ctx.fillRect(bx,300+(i%2)*30,40,200);}\n  // 地面\n  ctx.fillStyle='#2a2438';ctx.fillRect(-50,GY,WORLD_W+100,H-GY);\n  ctx.fillStyle='#3a3252';ctx.fillRect(-50,GY,WORLD_W+100,6);\n  if(!player){ctx.restore();return;}\n  // 残影\n  after.forEach(a=>drawPlayerFig(a.x,a.y,a.face,'dash',a.t*2.5));\n  parts.forEach(p=>{ctx.save();ctx.translate(p.x,p.y);ctx.rotate(p.rot);ctx.globalAlpha=Math.min(1,(p.life-p.t)*2);\n    ctx.fillStyle=p.c;ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h);ctx.restore();});\n  enemies.forEach(e=>{if(!e.dead||e.deadT>0.6)drawEnemy(e);});\n  drawPlayerFig(player.x,player.y,player.face,player.state,player.ifr>0&&Math.floor(player.ifr*16)%2===0?0.4:1);\n  fx.forEach(f=>{ctx.globalAlpha=1-f.t/f.life;ctx.fillStyle=f.c;ctx.fillRect(f.x-f.r/2,f.y-f.r/2,f.r,f.r);});\n  ctx.globalAlpha=1;ctx.restore();\n  if(game.flash>0){ctx.fillStyle='rgba(180,240,255,'+game.flash*1.6+')';ctx.fillRect(0,0,W,H);}\n  // UI\n  ctx.fillStyle='#000a';ctx.fillRect(14,14,220,58);\n  ctx.fillStyle='#333';ctx.fillRect(24,26,160,12);\n  ctx.fillStyle=player.hp>30?'#5ee07a':'#e04b4b';ctx.fillRect(24,26,160*player.hp/player.maxHp,12);\n  ctx.strokeStyle='#888';ctx.strokeRect(24,26,160,12);\n  ctx.fillStyle='#cfd2ff';ctx.font='13px Arial';\n  ctx.fillText('HP '+Math.ceil(player.hp)+' / '+player.maxHp,24,60);\n  ctx.fillStyle='#9fa3d0';ctx.fillText('波次 '+game.wave,190,38);\n  if(player.combo>1){ctx.fillStyle='#ffd27d';ctx.font='bold 26px Arial';\n    ctx.fillText(player.combo+' HITS',W-150,60);}\n  ctx.fillStyle='#666a99';ctx.font='12px Arial';\n  ctx.fillText('A/D移动 Space跳 J连斩 K蓄力 L疾冲 I弹反 R重开',16,H-12);\n  if(game.playing&&enemies.filter(e=>!e.dead).length===0){\n    ctx.fillStyle='#ffd27d';ctx.font='bold 22px Arial';ctx.textAlign='center';\n    ctx.fillText('下一波来袭…',W/2,120);ctx.textAlign='left';}\n}\n// ---------- 检查接口 ----------\nwindow.combatBenchState=function(){\n  return{ready:game.ready,\n    playerAlive:!!player&&player.hp>0,\n    enemyCount:enemies?enemies.filter(e=>!e.dead).length:0,\n    hitCount:game.hitCount,\n    limbBreakCount:game.limbBreaks,\n    playing:game.playing};\n};\n</script>\n</body>\n"
}