e) killEnemy(e, dir);\n}\n\nfunction killEnemy(e, dir){\n  e.alive = false;\n  e.deathT = 0;\n  G.killCount++;\n  Audio_.death();\n  addHitStop(0.09);\n  addShake(9);\n  debris(e.x, e.y-e.h*0.5, e.type==='brute'?'#7a5a3a':'#7d3f52');\n  // 爆出所有剩余肢体\n  for(const l of e.limbs){\n    if(!l.severed){\n      l.severed = true; l.ang = R(0,TAU); l.av = R(-10,10);\n      l.bx = e.x + l.ox*e.face; l.by = e.y - e.h*0.5 + l.oy;\n      l.bvx = dir*R(120,300); l.bvy = R(-360,-120);\n      l.spin = R(-14,14); l.rot = R(0,TAU);\n      G.limbBreakCount++;\n      debris(l.bx, l.by, '#a04a5c');\n    }\n  }\n  G.combo += 2;\n  G.comboTimer = 1.5;\n  floatingText(e.x, e.y-e.h-20, '斩!', '#ffd166', 22);\n  if(G.combo > G.comboPeak) G.comboPeak = G.combo;\n}\n\n/* ================= 玩家更新 ================= */\nfunction updatePlayer(dt){\n  const P = player;\n  P.stateT += dt;\n  P.invuln = Math.max(0, P.invuln - dt);\n  P.dashCd = Math.max(0, P.dashCd - dt);\n  P.parryCd = Math.max(0, P.parryCd - dt);\n  P.parryT = Math.max(0, P.parryT - dt);\n  P.hurtT = Math.max(0, P.hurtT - dt);\n  P.landT = Math.max(0, P.landT - dt);\n\n  if(P.hp <= 0) return;\n\n  let moveX = 0;\n  if(keys['a'] || keys['arrowleft']) moveX -= 1;\n  if(keys['d'] || keys['arrowright']) moveX += 1;\n\n  // 输入缓冲\n  if(pressed['j']) P.bufAtk = 0.16;\n  if(pressed['k']) P.bufHeavy = 0.16;\n  if(pressed['i']) P.bufSpecial = 0.16;\n  if(pressed['l']) P.bufDash = 0.16;\n  P.bufAtk = Math.max(0,(P.bufAtk||0)-dt);\n  P.bufHeavy = Math.max(0,(P.bufHeavy||0)-dt);\n  P.bufSpecial = Math.max(0,(P.bufSpecial||0)-dt);\n  P.bufDash = Math.max(0,(P.bufDash||0)-dt);\n\n  // 冲刺\n  if(P.dashT > 0){\n    P.dashT -= dt;\n    P.vx = P.face * 720 * (P.dashT>0.04?1:0.55);\n    P.vy *= 0.86;\n    P.invuln = Math.max(P.invuln, 0.05);\n    if(P.dashT % 0.03 < dt) {\n      P.afterimages.push({x:P.x, y:P.y, face:P.face, life:0.22, max:0.22});\n    }\n    if(P.dashT<=0){ P.state='idle'; }\n    // 冲刺攻击取消\n    if(P.bufAtk>0 && P.dashT<0.12){ P.dashT=0; P.bufAtk=0; P.state='attack'; playerAttack('light1'); P.vx = P.face*260; }\n    return;\n  }\n\n  // 攻击中\n  if(P.state==='attack'){\n    const a = ATK[P.attackType];\n    P.attackT += dt;\n    // 攻击中的减速/位移\n    P.vx = approach(P.vx, 0, 900*dt);\n    if(P.attackT >= a.hit[0] && P.attackT <= a.hit[1] && !P.attackHit){\n      P.attackHit = true;\n      doAttackHitbox();\n    }\n    // 连段输入\n    const canChain = P.attackT > a.hit[0]*0.75;\n    if(canChain){\n      if(P.bufAtk>0 && a.next){\n        P.bufAtk = 0;\n        playerAttack(a.next);\n        return;\n      }\n      if(P.bufHeavy>0 && (P.attackType!=='heavy')){\n        P.bufHeavy=0;\n        playerAttack('heavy');\n        return;\n      }\n      if(P.bufSpecial>0){\n        P.bufSpecial=0;\n        playerAttack(P.onGround?'launcher':'plunge');\n        return;\n      }\n      if(P.bufDash>0){\n        P.bufDash=0;\n        startDash();\n        return;\n      }\n    }\n    if(P.attackT >= a.dur){ P.state='idle'; P.stateT=0; }\n    // 空中攻击落地\n    if(!P.onGround && P.attackType==='air' && P.y>=GROUND_Y){ P.state='idle'; }\n    return;\n  }\n\n  // 蓄力重击（按住K）\n  if(P.state==='charge'){\n    P.vx = approach(P.vx, 0, 1200*dt);\n    if(keys['k']){\n      P.charge = Math.min(1.4, P.charge + dt);\n      if(P.charge > 0.75 && !P.chargedFx){ P.chargedFx = true; Audio_.tone(600,0.15,'sine',0.08,1100); }\n    } else {\n      // 释放\n      P.state='idle'; P.chargedFx=false;\n      const lvl = P.charge;\n      playerAttack('heavy');\n      const a = ATK.heavy;\n      const mul = 1 + lvl*0.9;\n      P.releaseMul = mul;\n      P.vx = P.face * (140 + lvl*260);\n      P.charge = 0;\n      if(lvl > 0.7){ addShake(6); }\n      return;\n    }\n    if(P.charge > 1.2){\n      // 自动释放\n      P.state='idle'; P.chargedFx=false;\n      playerAttack('heavy'); P.charge=0;\n      return;\n    }\n    return;\n  }\n\n  // 跳跃/重力\n  if(!P.onGround){\n    P.vy += 2100*dt;\n    P.vx += moveX * 900 * dt;\n    P.vx = clamp(P.vx, -380, 380);\n  } else {\n    const accel = 2400, maxSpd = 340;\n    if(moveX!==0){\n      P.vx = approach(P.vx, moveX*maxSpd, accel*dt);\n      P.face = moveX;\n    } else {\n      P.vx = approach(P.vx, 0, 2600*dt);\n    }\n  }\n\n  // 跳\n  if((tapped(' ')) && (P.onGround || P.jumps < P.maxJumps)){\n    if(!P.onGround) P.jumps++;\n    else P.jumps = 1;\n    P.vy = -760;\n    P.onGround = false;\n    P.state='air';\n    Audio_.jump();\n    for(let i=0;i<6;i++) particles.push({kind:'puff', x:P.x+R(-10,10), y:P.y, vx:R(-90,90), vy:R(-20,60), life:0.2, max:0.2, size:R(4,10), col:'#9a8fc0', grav:100});\n  }\n  // 空中二段\n  if(!P.onGround && tapped(' ') && P.jumps < P.maxJumps && P.vy > -100){\n    // handled above\n  }\n\n  // 冲刺/闪避\n  if(P.bufDash>0 && P.dashCd<=0 && (P.onGround || P.airDash>0)){\n    P.bufDash=0;\n    startDash();\n    return;\n  }\n  // 冲刺（无缓冲直接按）\n  if(tapped('l') && P.dashCd<=0 && (P.onGround || P.airDash>0) && P.state!=='dash'){\n    startDash();\n    return;\n  }\n\n  // 重击蓄力开始\n  if(P.bufHeavy>0 && P.state!=='charge'){\n    P.bufHeavy=0;\n    P.state='charge'; P.charge=0; P.charging=true;\n    Audio_.tone(220,0.1,'sine',0.05,300);\n    return;\n  }\n  // 主攻击\n  if(P.bufAtk>0){\n    P.bufAtk=0;\n    playerAttack(P.onGround?'light1':'air');\n    return;\n  }\n  // 特色：破势/挑空\n  if(P.bufSpecial>0){\n    P.bufSpecial=0;\n    if(P.onGround) playerAttack('launcher');\n    else { startParry(); }\n    return;\n  }\n\n  // 弹反\n  if(tapped('i') && P.onGround) startParry();\n\n  // 落地\n  if(P.y >= GROUND_Y && !P.onGround){\n    P.y = GROUND_Y; P.vy = 0; P.onGround = true; P.jumps = 0; P.airDash = 1;\n    P.landT = 0.16;\n    Audio_.noise(0.1,0.12,'lowpass',400,100,0.8);\n    for(let i=0;i<8;i++) particles.push({kind:'puff', x:P.x+R(-14,14), y:GROUND_Y, vx:R(-140,140), vy:R(-60,-10), life:0.28, max:0.28, size:R(5,12), col:'#8d82b5', grav:300});\n  }\n  if(P.y > GROUND_Y){ P.y = GROUND_Y; P.onGround=true; P.vy=0; }\n\n  P.state = P.onGround ? (Math.abs(P.vx)>20?'run':'idle') : (P.st