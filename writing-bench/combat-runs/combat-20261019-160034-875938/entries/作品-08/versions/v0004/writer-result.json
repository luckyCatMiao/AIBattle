  "partial_text": "<!DOCTYPE html>\n<html lang=\"zh\">\n<head>\n<meta charset=\"utf-8\">\n<title>断刃回廊</title>\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<style>\n  html,body{margin:0;height:100%;background:#07070b;overflow:hidden;font-family:\"Segoe UI\",system-ui,sans-serif;}\n  #wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;}\n  canvas{display:block;box-shadow:0 0 60px #000 inset, 0 0 30px rgba(120,40,160,.25);touch-action:none;}\n  #hint{position:fixed;left:0;right:0;bottom:6px;text-align:center;color:#4a4358;font-size:12px;pointer-events:none;letter-spacing:1px}\n</style>\n</head>\n<body>\n<div id=\"wrap\"><canvas id=\"cv\" width=\"960\" height=\"540\"></canvas></div>\n<div id=\"hint\">A/D 移动 · Space 跳 · J 斩 · K 重 · L 闪 · I 破势 · R 重开</div>\n<script>\n(function(){\n\"use strict\";\n\n/* ================= 基础 ================= */\nconst cv = document.getElementById('cv');\nconst ctx = cv.getContext('2d');\nconst VW = 960, VH = 540;\nlet viewW = VW, viewH = VH;\n\nfunction resize(){\n  const ww = window.innerWidth, wh = window.innerHeight;\n  let scale = Math.min(ww / VW, wh / VH);\n  // 宽屏时保持高度优先，允许更宽视野\n  let cw = VW, ch = VH;\n  const ratioW = ww / wh;\n  if(ratioW > VW/VH){\n    ch = VH;\n    cw = Math.round(VH * ratioW);\n    if(cw > 1600) { cw = 1600; ch = Math.round(cw/ratioW); }\n  } else {\n    cw = VW;\n    ch = Math.round(VW / ratioW);\n  }\n  // 保证最小 960x540 显示\n  const s = Math.min(ww/cw, wh/ch);\n  cv.width = Math.round(cw);\n  cv.height = Math.round(ch);\n  viewW = cv.width; viewH = cv.height;\n  const dprScale = s;\n  cv.style.width = Math.round(cw*s) + 'px';\n  cv.style.height = Math.round(ch*s) + 'px';\n}\nwindow.addEventListener('resize', resize);\nresize();\n\n/* ================= 随机/工具 ================= */\nconst R = (a,b)=>a+Math.random()*(b-a);\nconst clamp=(v,a,b)=>v<a?a:v>b?b:v;\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst TAU = Math.PI*2;\nfunction approach(v,t,d){ if(v<t) return Math.min(t,v+d); return Math.max(t,v-d); }\n\n/* ================= 音频（合成） ================= */\nconst Audio_ = {\n  ctx:null, master:null, muted:false, ready:false,\n  init(){\n    if(this.ready) return;\n    try{\n      const AC = window.AudioContext || window.webkitAudioContext;\n      if(!AC) return;\n      this.ctx = new AC();\n      this.master = this.ctx.createGain();\n      this.master.gain.value = 0.55;\n      this.master.connect(this.ctx.destination);\n      // 简易混响\n      const conv = this.ctx.createConvolver();\n      const len = Math.floor(this.ctx.sampleRate * 0.55);\n      const buf = this.ctx.createBuffer(2, len, this.ctx.sampleRate);\n      for(let c=0;c<2;c++){\n        const d = buf.getChannelData(c);\n        for(let i=0;i<len;i++){\n          d[i] = (Math.random()*2-1) * Math.pow(1 - i/len, 3.2) * 0.6;\n        }\n      }\n      conv.buffer = buf;\n      const wet = this.ctx.createGain(); wet.gain.value = 0.30;\n      conv.connect(wet); wet.connect(this.master);\n      this.reverb = conv;\n      this.ready = true;\n    }catch(e){ this.ready = false; }\n  },\n  resume(){ if(this.ctx && this.ctx.state === 'suspended'){ this.ctx.resume(); } },\n  tone(freq, dur, type, vol, slideTo, delay){\n    if(!this.ready || this.muted) return;\n    const t0 = this.ctx.currentTime + (delay||0);\n    const o = this.ctx.createOscillator();\n    const g = this.ctx.createGain();\n    o.type = type || 'sine';\n    o.frequency.setValueAtTime(freq, t0);\n    if(slideTo) o.frequency.exponentialRampToValueAtTime(Math.max(20,slideTo), t0+dur);\n    g.gain.setValueAtTime(0.0001, t0);\n    g.gain.exponentialRampToValueAtTime(vol, t0 + Math.min(0.012, dur*0.3));\n    g.gain.exponentialRampToValueAtTime(0.0001, t0 + dur);\n    o.connect(g);\n    g.connect(this.master);\n    if(this.reverb){ const rv = this.ctx.createGain(); rv.gain.value=0.25; g.connect(rv); rv.connect(this.reverb); }\n    o.start(t0); o.stop(t0 + dur + 0.02);\n  },\n  noise(dur, vol, filtType, f0, f1, q){\n    if(!this.ready || this.muted) return;\n    const t0 = this.ctx.currentTime;\n    const len = Math.max(1, Math.floor(this.ctx.sampleRate * dur));\n    const buf = this.ctx.createBuffer(1, len, this.ctx.sampleRate);\n    const d = buf.getChannelData(0);\n    for(let i=0;i<len;i++){\n      const env = Math.pow(1 - i/len, 1.6);\n      d[i] = (Math.random()*2-1) * env;\n    }\n    const src = this.ctx.createBufferSource(); src.buffer = buf;\n    const bp = this.ctx.createBiquadFilter();\n    bp.type = filtType || 'bandpass';\n    bp.frequency.setValueAtTime(f0||1200, t0);\n    if(f1) bp.frequency.exponentialRampToValueAtTime(Math.max(40,f1), t0+dur);\n    bp.Q.value = q||1.2;\n    const g = this.ctx.createGain();\n    g.gain.setValueAtTime(vol, t0);\n    g.gain.exponentialRampToValueAtTime(0.0001, t0+dur);\n    src.connect(bp); bp.connect(g); g.connect(this.master);\n    if(this.reverb){ const rv=this.ctx.createGain(); rv.gain.value=0.2; g.connect(rv); rv.connect(this.reverb); }\n    src.start(t0); src.stop(t0+dur+0.02);\n  },\n  swing(n){ // n: 0 轻 1 重\n    if(n){ this.noise(0.28, 0.30, 'bandpass', 420, 180, 1.1); this.tone(150,0.22,'sawtooth',0.10,60); }\n    else { this.noise(0.14, 0.20, 'bandpass', 1800, 700, 1.4); }\n  },\n  hit(power){ // 1..3\n    const p = clamp(power,1,3);\n    this.tone(120 - p*18, 0.13 + p*0.05, 'square', 0.10 + p*0.03, 38);\n    this.noise(0.16 + p*0.07, 0.34 + p*0.06, 'bandpass', 900/p, 120, 0.8);\n    this.noise(0.06, 0.28, 'lowpass', 2600, 400, 0.6);\n    if(p >= 2.4) this.tone(70, 0.32, 'sine', 0.16, 28);\n  },\n  break_(){\n    this.noise(0.35, 0.42, 'bandpass', 2400, 220, 0.9);\n    this.tone(200,0.28,'square',0.14,40);\n    this.tone(90,0.4,'sine',0.16,25,0.03);\n  },\n  dash(){ this.noise(0.22,0.18,'highpass',900,300,0.7); this.tone(320,0.12,'sine',0.05,700); },\n  jump(){ this.tone(240,0.12,'square',0.05,480); this.noise(0.09,0.10,'bandpass',1200,600,1); },\n  hurt(){ this.tone(180,0.22,'sawtooth',0.12,60); this.noise(0.2,0.24,'lowpass',800,150,0.8); },\n  parry(){ this.tone(1400,0.16,'sine',0.16,900); this.tone(2100,0.1,'square',0.06,1600); this.noise(0.14,0.2,'highpass',3000,1400,0.7); },\n  death(){ this.tone(140,0.9,'sawtooth',0.14,40); this.noise(0.8,0.25,'lowpass',900,80,0.7); },\n  wave(){ this.tone(320,0.2,'triangle',0.08,640); this.tone(480,0.24,'triangle',0.06,960,0.08); }\n};\n\n/* ================= 输入 ================= */\nconst keys = Object.create(null);\nconst pressed = Object.create(null);\nconst GAME_KEYS = new Set(['a','d','arrowleft','arrowright',' ','space','j','k','l','i','r','enter','w','arrowup']);\nfunction keyDown(e){\n  const k = e.key.toLowerCase();\n  if(GAME_KEYS.has(k) || k===' '){ e.preventDefault(); }\n  if(!keys[k]) pressed[k] = true;\n  keys[k] = true;\n  Audio_.init(); Audio_.resume();\n  if(k==='m') toggleMute();\n}\nfunction keyUp(e){\n  const k = e.key.toLowerCase();\n  if(GAME_KEYS.has(k)) e.preventDefault();\n  keys[k] = false;\n}\nwindow.addEventListener('keydown', keyDown, {passive:false});\nwindow.addEventListener('keyup', keyUp, {passive:false});\nwindow.addEventListener('blur', ()=>{ for(const k in keys) keys[k]=false; for(const k in pressed) pressed[k]=false; });\n\nfunction tapped(k){ if(pressed[k]){ return true; } return false; }\nfunction consume(){ for(const k in pressed) pressed[k]=false; }\n\n/* ================= 游戏状态 ================= */\nconst G = {\n  ready:true, playing:false, started:false, gameOver:false,\n  t:0, dt:0, last:0,\n  hitStop:0, hitStopScale:0.0, shake:0, shakeDecay:1,\n  flash:0, slowmo:0,\n  camX:0, camTargetX:0,\n  hitCount:0, limbBreakCount:0,\n  killCount:0, wave:0, waveTimer:0, waveBanner:0, waveBannerText:'',\n  comboTimer:0, combo:0, comboPeak:0, comboDisplay:0, lastHitTime:-99,\n  scoreTexts:[], flashColor:'255,255,255'\n};\n\n/* ================= 世界常量 ================= */\nconst GROUND_Y = 430;\nconst ARENA_MIN = -80, ARENA_MAX = 1900;\n\n/* ================= 玩家 ================= */\nconst player = {\n  x:300, y:GROUND_Y, vx:0, vy:0, w:34, h:64,\n  face:1, onGround:true, jumps:0, maxJumps:2,\n  hp:100, maxHp:100,\n  state:'idle', stateT:0,\n  attackT:0, attackDur:0, attackHit:false, attackType:'', attackChain:0,\n  invuln:0, dashT:0, dashCd:0, airDash:1,\n  charge:0, charging:false, chargingHeld:false,\n  parryT:0, parryCd:0,\n  lunge:0, hitLag:0,\n  trail:[], // 刀光轨迹\n  afterimages:[],\n  hurtT:0, landT:0, deadT:0,\n  equipped:0\n};\n\nfunction resetPlayer(){\n  player.x=300; player.y=GROUND_Y; player.vx=0; player.vy=0;\n  player.face=1; player.onGround=true; player.jumps=0;\n  player.hp=player.maxHp; player.state='idle'; player.stateT=0;\n  player.attackT=0; player.invuln=0; player.dashT=0; player.dashCd=0; player.airDash=1;\n  player.charge=0; player.charging=false; player.chargingHeld=false;\n  player.parryT=0; player.parryCd=0; player.lunge=0; player.hitLag=0;\n  player.trail.length=0; player.afterimages.length=0;\n  player.hurtT=0; player.landT=0; player.deadT=0; player.attackChain=0;\n}\n\n/* ================= 敌人 ================= */\nlet enemies = [];\nlet particles = [];\nlet projectiles = [];\nlet pickups = [];\n\nconst LIMB_DEFS = [\n  {id:'head', r:14, ox:0, oy:-46},\n  {id:'armL', r:10, ox:-16, oy:-18},\n  {id:'armR', r:10, ox:16, oy:-18},\n  {id:'legL', r:11, ox:-9, oy:24},\n  {id:'legR', r:11, ox:9, oy:24}\n];\n\nfunction makeEnemy(type, x){\n  const base = {\n    type, x, y:GROUND_Y, vx:0, vy:0, w:40, h:70,\n    face:-1, hp:100, maxHp:100, state:'idle', stateT:0,\n    hitT:0, stunT:0, breakStun:0,\n    attackWind:0, attackPhase:'none', attackHit:false, attackCd:0,\n    limbs:[], alive:true, deathT:0, flashT:0,\n    knock:0, launched:false, groundT:0, id:Math.random(),\n    targetX:0, seed:Math.random()*100, speedBase:0\n  };\n  if(type==='grunt'){\n    base.hp=base.maxHp=110; base.speedBase=1.0; base.w=42; base.h=74;\n    base.limbs = LIMB_DEFS.map(l=>({...l, hp: 30, maxHp:30, broken:false, ang:0, av:0, bx:0, by:0, bvx:0, bvy:0, severed:false, scale:1}));\n    base.limbHp = 100;\n  } else if(type==='brute'){\n    base.hp=base.maxHp=220; base.speedBase=0.62; base.w=58; base.h=96;\n    base.limbs = [\n      {id:'head', r:16, ox:0, oy:-62, hp:60, maxHp:60, broken:false, amputated:false},\n      {id:'armL', r:15, ox:-26, oy:-22, hp:75, maxHp:75, broken:false},\n      {id:'armR', r:15, ox:26, oy:-22, hp:75, maxHp:75, broken:false},\n      {id:'legL', r:14, ox:-13, oy:34, hp:60, maxHp:60, broken:false},\n      {id:'legR', r:14, ox:13, oy:34, hp:60, maxHp:60, broken:false}\n    ].map(l=>({...l, ang:0, av:0, bx:0, by:0, bvx:0, bvy:0, severed:false, scale:1}));\n    base.limbHp = 220;\n  } else if(type==='flyer'){\n    base.hp=base.maxHp=70; base.speedBase=1.4; base.y=GROUND_Y-150; base.w=34; base.h=54;\n    base.limbs = [\n      {id:'head', r:10, ox:0, oy:-24, hp:20, maxHp:20, broken:false},\n      {id:'armL', r:11, ox:-20, oy:-4, hp:22, maxHp:22, broken:false},\n      {id:'armR', r:11, ox:20, oy:-4, hp:22, maxHp:22, broken:false},\n      {id:'legL', r:8, ox:-7, oy:20, hp:16, maxHp:16, broken:false},\n      {id:'legR', r:8, ox:7, oy:20, hp:16, maxHp:16, broken:false}\n    ].map(l=>({...l, ang:0, av:0, bx:0, by:0, bvx:0, bvy:0, severed:false, scale:1}));\n    base.limbHp = 70;\n  }\n  if(type==='flyer'){ base.airPhase = Math.random()*TAU; }\n  return base;\n}\n\n/* ================= 粒子 ================= */\nfunction spark(x,y,dir,count,power,col){\n  for(let i=0;i<count;i++){\n    const a = dir + R(-1.3,1.3);\n    const sp = R(80, 380)*power;\n    particles.push({kind:'spark', x, y, vx:Math.cos(a)*sp, vy:Math.sin(a)*sp - R(20,120)*power,\n      life:R(0.12,0.32), max:0.32, size:R(1,3.2), col:col||'#ffe9a8', grav:600});\n  }\n}\nfunction slashPuff(x,y,dir,power){\n  for(let i=0;i<10;i++){\n    const a = dir + R(-0.45,0.45);\n    const sp = R(60,260)*power;\n    particles.push({kind:'puff', x, y, vx:Math.cos(a)*sp, vy:Math.sin(a)*sp, life:R(0.2,0.45), max:0.45, size:R(6,18), col:'#cdb8ff', grav:-30});\n  }\n}\nfunction debris(x,y,col){\n  for(let i=0;i<14;i++){\n    const a = R(0,TAU), sp = R(80,320);\n    particles.push({kind:'deb', x, y, vx:Math.cos(a)*sp, vy:Math.sin(a)*sp-R(80,260), life:R(0.5,1.1), max:1.1,\n      size:R(2,5), col, grav:900, rot:R(0,TAU), rv:R(-14,14)});\n  }\n}\nfunction updateParticles(dt){\n  for(let i=particles.length-1;i>=0;i--){\n    const p = particles[i];\n    p.life -= dt;\n    if(p.life<=0){ particles.splice(i,1); continue; }\n    p.x += p.vx*dt; p.y += p.vy*dt;\n    p.vy += (p.grav||600)*dt;\n    p.vx *= (1 - 2.2*dt);\n    if(p.rot!==undefined) p.rot += p.rv*dt;\n    if(p.kind==='deb' && p.y > GROUND_Y){ p.y = GROUND_Y; p.vy *= -0.4; p.vx*=0.6; }\n  }\n}\n\n/* ================= 相机 ================= */\nconst cam = {x:0, y:0, shakeX:0, shakeY:0, zoom:1};\n\n/* ================= 攻击定义 ================= */\nconst ATK = {\n  light1:{dur:0.30, hit:[0.07,0.15], dmg:11, reach:60, h:52, kb:130, up:0, chain:0.17, next:'light2', move:110, sfx:0, limb:8},\n  light2:{dur:0.30, hit:[0.07,0.15], dmg:12, reach:64, h:56, kb:160, up:0, chain:0.17, next:'light3', move:130, sfx:0, limb:9},\n  light3:{dur:0.42, hit:[0.10,0.20], dmg:20, reach:74, h:64, kb:300, up:-260, chain:0.30, next:'', move:170, sfx:1, limb:20},\n  heavy:{dur:0.62, hit:[0.22,0.34], dmg:34, reach:88, h:78, kb:420, up:-180, chain:0.44, next:'', move:120, sfx:1, limb:34},\n  air:{dur:0.28, hit:[0.05,0.14], dmg:13, reach:62, h:60, kb:120, up:0, chain:0.16, next:'', move:60, sfx:0, limb:8},\n  launcher:{dur:0.44, hit:[0.12,0.26], dmg:18, reach:66, h:96, kb:80, up:-620, chain:0.34, next:'', move:80, sfx:1, limb:18},\n  plunge:{dur:0.5, hit:[0.0,0.5], dmg:26, reach:48, h:80, kb:80, up:0, chain:0, next:'', move:0, sfx:1, limb:24}\n};\n\n/* ================= 战斗逻辑 ================= */\nfunction spawnWave(){\n  G.wave++;\n  const n = G.wave;\n  const count = 2 + Math.min(4, Math.floor((n-1)/2));\n  const types = [];\n  for(let i=0;i<count;i++){\n    let t = 'grunt';\n    if(n>=2 && i%3===2) t='brute';\n    if(n>=3 && i%4===1) t='flyer';\n    if(n>=5 && Math.random()<0.3) t = Math.random()<0.5?'brute':'flyer';\n    types.push(t);\n  }\n  // 保证至少两种类型\n  if(n>=2 && types.every(t=>t==='grunt')) types[types.length-1]='brute';\n  if(n>=3 && types.every(t=>t==='grunt')) types[types.length-1]='flyer';\n\n  const spawnX = player.x + (player.face>0? 1:-1);\n  types.forEach((t,i)=>{\n    let x = player.x + (i%2===0?1:-1) * (480 + i*90 + R(0,80));\n    x = clamp(x, ARENA_MIN+60, ARENA_MAX-60);\n    const e = makeEnemy(t, x);\n    e.face = x > player.x ? -1 : 1;\n    // 入场：从空中落下/淡入\n    e.spawnT = 0.45;\n    enemies.push(e);\n  });\n  G.waveBanner = 1.8;\n  G.waveBannerText = '第 ' + n + ' 波';\n  Audio_.wave();\n}\n\nfunction startGame(){\n  G.started = true; G.playing = true; G.gameOver = false;\n  G.hitCount = 0; G.limbBreakCount = 0; G.killCount = 0; G.wave = 0; G.combo=0; G.comboPeak=0;\n  enemies.length = 0; particles.length = 0; projectiles.length = 0; pickups.length = 0;\n  G.scoreTexts.length = 0;\n  resetPlayer();\n  G.waveTimer = 0.2;\n  G.camX = player.x - viewW*0.5;\n  Audio_.init(); Audio_.resume();\n  spawnWave();\n}\n\nfunction addShake(amt){\n  G.shake = Math.min(26, G.shake + amt);\n}\nfunction addHitStop(scale){\n  G.hitStop = Math.max(G.hitStop, scale);\n}\n\nfunction floatingText(x,y,text,col,size){\n  G.scoreTexts.push({x,y,text,col:col||'#fff',size:size||16,life:0.9,max:0.9,vy:-70});\n}\n\nfunction playerAttack(type){\n  const a = ATK[type];\n  player.state = 'attack';\n  player.attackType = type;\n  player.attackT = 0;\n  player.attackDur = a.dur;\n  player.attackHit = false;\n  player.attackChain = 0;\n  if(a.move) player.vx += player.face * a.move * 0.55;\n  Audio_.swing(a.sfx);\n  // 刀光轨迹初始化\n  player.trail.push({pts:[], life:0.22, max:0.22, type});\n}\n\nfunction doAttackHitbox(){\n  const a = ATK[player.attackType];\n  const ax = player.x + player.face * (18 + a.reach*0.5);\n  const ay = player.y - player.h*0.5 - 6;\n  const hw = a.reach*0.62, hh = a.h*0.6;\n  let hitAny = false;\n  for(const e of enemies){\n    if(!e.alive) continue;\n    if(Math.abs(e.x - ax) < hw + e.w*0.5 && Math.abs((e.y - e.h*0.5) - ay) < hh + e.h*0.5){\n      const dir = Math.sign(e.x - player.x) || player.face;\n      hitEnemy(e, a, dir);\n      hitAny = true;\n    }\n  }\n  if(hitAny){\n    const power = a.dmg>25?3:(a.dmg>15?2:1);\n    addHitStop(0.055 + power*0.032);\n    addShake(power===3?11:(power===2?7:4));\n    Audio_.hit(power);\n  } else {\n    // 空挥轻微\n    addHitStop(0.012);\n  }\n}\n\nfunction hitEnemy(e, a, dir){\n  let dmg = a.dmg;\n  // 连击加成\n  const cmul = 1 + Math.min(0.6, G.combo*0.035);\n  dmg = Math.round(dmg * cmul * R(0.94,1.06));\n\n  // 选择命中部位\n  let targetLimb = null;\n  const hy = player.y - player.h*0.5 + (a.up<-300? -10 : 0);\n  let bestD = 1e9;\n  for(const l of e.limbs){\n    if(l.severed) continue;\n    let lx = e.x + l.ox, ly = e.y - e.h*0.5 + l.oy + e.h*0.5;\n    ly = e.y - e.h*0.5 + (l.oy + e.h*0.5);\n    // 更简单：以敌人脚底为基准\n    lx = e.x + l.ox * (e.face);\n    ly = e.y - e.h + (l.oy + e.h*0.5) + e.h*0.5;\n    ly = e.y - e.h*0.5 + l.oy;\n    const d = Math.abs(lx - (player.x + player.face*30)) + Math.abs(ly - (player.y - player.h*0.5));\n    if(d < bestD){ bestD = d; targetLimb = l; }\n  }\n  if(targetLimb && !targetLimb.severed){\n    targetLimb.hp -= a.limb * (0.8 + Math.random()*0.5);\n    if(targetLimb.hp <= 0){\n      severLimb(e, targetLimb, dir, a);\n    }\n  }\n\n  e.hp -= dmg;\n  e.hitT = 0.16;\n  e.flashT = 0.14;\n  e.knock = a.kb * (e.type==='brute'?0.45:1) * (dir>0?1:-1);\n  if(a.up){\n    e.vy = a.up * (e.type==='brute'?0.42:1);\n    e.y = Math.min(e.y, GROUND_Y-2);\n    e.launched = true;\n  }\n  if(e.vy < -80) { e.onGround = false; }\n  G.hitCount++;\n  G.combo++;\n  G.comboTimer = 1.5;\n  G.comboPeak = Math.max(G.comboPeak, G.combo);\n  G.lastHitTime = G.t;\n\n  const power = a.dmg>25?3:(a.dmg>15?2:1);\n  const cx = player.x + player.face*(40+Math.random()*30);\n  const cy = player.y - player.h*0.5 + R(-16,