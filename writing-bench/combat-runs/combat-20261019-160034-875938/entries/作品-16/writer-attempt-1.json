  "text": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1\">\n<title>断界：战斗试作</title>\n<style>\nhtml,body{margin:0;width:100%;height:100%;overflow:hidden;background:#050813;color:#eefaff;font-family:Inter,\"Microsoft YaHei\",system-ui,sans-serif}\n*{box-sizing:border-box}\n#game{position:fixed;inset:0;width:100%;height:100%;display:block;background:#050813;outline:none}\n#mute{position:fixed;z-index:8;right:18px;top:16px;border:1px solid #527083;background:rgba(5,12,24,.78);color:#dffaff;padding:8px 13px;border-radius:5px;font-weight:700;cursor:pointer;letter-spacing:.08em}\n#mute:hover{background:#163044;border-color:#79e8ff}\n#help{position:fixed;z-index:6;left:50%;bottom:12px;transform:translateX(-50%);white-space:nowrap;padding:8px 16px;border:1px solid rgba(113,226,255,.3);border-radius:5px;background:rgba(3,8,17,.76);font-size:13px;letter-spacing:.04em;color:#bcd4dc;pointer-events:none;box-shadow:0 0 30px rgba(0,0,0,.25)}\n#help b{color:#fff;margin-left:10px}\n#help b:first-child{margin-left:0}\n#overlay{position:fixed;z-index:7;inset:0;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 45%,rgba(12,31,49,.36),rgba(2,4,10,.82));transition:opacity .16s}\n#overlay.hidden{opacity:0;pointer-events:none}\n#panel{text-align:center;min-width:440px;padding:35px 46px 31px;border:1px solid rgba(116,229,255,.45);background:linear-gradient(145deg,rgba(8,19,31,.95),rgba(5,8,17,.93));box-shadow:0 0 70px rgba(0,200,255,.12),inset 0 0 40px rgba(42,157,190,.05);clip-path:polygon(20px 0,100% 0,100% calc(100% - 20px),calc(100% - 20px) 100%,0 100%,0 20px)}\n#title{font-size:50px;font-weight:900;letter-spacing:.25em;margin-left:.25em;color:#f4feff;text-shadow:0 0 18px #49cdec}\n#sub{margin:7px 0 23px;color:#76dff3;letter-spacing:.4em;font-size:12px}\n#desc{color:#aec1c9;font-size:14px;line-height:1.8;margin-bottom:22px}\n#start{border:1px solid #6ee8ff;background:#102c3b;color:#fff;padding:12px 38px;font-weight:900;font-size:16px;letter-spacing:.2em;cursor:pointer;box-shadow:0 0 22px rgba(74,223,255,.15)}\n#start:hover{background:#1b5065}\n#prompt{margin-top:13px;color:#647985;font-size:12px}\n@media(max-width:700px){#help{font-size:10px;padding:6px 8px}#panel{min-width:0;width:88%;padding:25px 16px}#title{font-size:36px}}\n</style>\n</head>\n<body>\n<canvas id=\"game\" tabindex=\"0\"></canvas>\n<button id=\"mute\">声音：开</button>\n<div id=\"help\"><b>A/D · ←/→</b> 移动　<b>SPACE</b> 跳跃追击　<b>J</b> 三段连斩　<b>K</b> 按住蓄力重斩　<b>L</b> 闪身　<b>I</b> 弹反　<b>R</b> 重开</div>\n<div id=\"overlay\">\n  <div id=\"panel\">\n    <div id=\"title\">断界</div>\n    <div id=\"sub\">RIFT SEVER / COMBAT PROTOCOL</div>\n    <div id=\"desc\">斩断绯铁人偶的武装肢体。<br>三段连斩可挑空，蓄满重斩直接断肢；观察红光，以弹反夺回攻势。</div>\n    <button id=\"start\">进入战斗</button>\n    <div id=\"prompt\">按 ENTER 确认 · 首次输入后启用合成音效</div>\n  </div>\n</div>\n<script>\n'use strict';\nconst canvas=document.getElementById('game'),ctx=canvas.getContext('2d');\nconst overlay=document.getElementById('overlay'),startBtn=document.getElementById('start');\nconst titleEl=document.getElementById('title'),subEl=document.getElementById('sub'),descEl=document.getElementById('desc'),promptEl=document.getElementById('prompt');\nconst muteBtn=document.getElementById('mute');\nlet W=1280,H=720,DPR=1,ground=550,ready=false,playing=false,playerAlive=true;\nlet player=null,enemies=[],parts=[],fx=[],camera=0,shake=0,hitStop=0,last=0,clock=0,spawnTimer=0,kills=0,wave=1,nextId=1;\nconst WORLD=2400,keys=Object.create(null);\nconst stats={hitCount:0,limbBreakCount:0};\nconst stars=Array.from({length:90},(_,i)=>({x:(i*197.73)%1800,y:18+(i*83.1)%350,r:.5+(i%4)*.35,a:.2+(i%7)*.08}));\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v));\nconst lerp=(a,b,t)=>a+(b-a)*t;\nconst approach=(v,t,d)=>v<t?Math.min(t,v+d):Math.max(t,v-d);\nconst rand=(a,b)=>a+Math.random()*(b-a);\nfunction resize(){\n  W=innerWidth;H=innerHeight;DPR=Math.min(devicePixelRatio||1,2);\n  canvas.width=Math.round(W*DPR);canvas.height=Math.round(H*DPR);\n  canvas.style.width=W+'px';canvas.style.height=H+'px';\n  ctx.setTransform(DPR,0,0,DPR,0,0);\n  ground=H*.79;\n}\naddEventListener('resize',resize);resize();\n\nlet ac=null,master=null,noiseBuffer=null,muted=false;\nfunction audioInit(){\n  if(muted)return;\n  try{\n    if(!ac){\n      ac=new (window.AudioContext||window.webkitAudioContext)();\n      master=ac.createGain();master.gain.value=.32;master.connect(ac.destination);\n      const n=ac.sampleRate*.35;noiseBuffer=ac.createBuffer(1,n,ac.sampleRate);\n      const d=noiseBuffer.getChannelData(0);for(let i=0;i<n;i++)d[i]=Math.random()*2-1;\n    }\n    if(ac.state==='suspended')ac.resume();\n  }catch(e){}\n}\nfunction tone(f,d,type='sine',vol=.1,endF=f,delay=0){\n  if(!ac||muted)return;\n  const t=ac.currentTime+delay,o=ac.createOscillator(),g=ac.createGain();\n  o.type=type;o.frequency.setValueAtTime(f,t);o.frequency.exponentialRampToValueAtTime(Math.max(20,endF),t+d);\n  g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);\n  o.connect(g);g.connect(master);o.start(t);o.stop(t+d+.02);\n}\nfunction noise(d=.08,vol=.12,rate=1,delay=0){\n  if(!ac||muted||!noiseBuffer)return;\n  const t=ac.currentTime+delay,s=ac.createBufferSource(),f=ac.createBiquadFilter(),g=ac.createGain();\n  s.buffer=noiseBuffer;s.playbackRate.value=rate;f.type='bandpass';f.frequency.value=900*rate;\n  g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.0001,t+d);\n  s.connect(f);f.connect(g);g.connect(master);s.start(t);s.stop(t+d+.02);\n}\nconst SFX={\n  swing(p=1){noise(.10,.08,1.4*p);tone(240*p,.10,'sawtooth',.04,90*p)},\n  hit(big=false){noise(big?.14:.075,big?.18:.11,big?.65:1.1);tone(big?78:115,big?.16:.09,'square',big?.13:.08,42)},\n  dash(){noise(.14,.09,1.8);tone(360,.12,'triangle',.055,95)},\n  parry(){tone(860,.17,'sine',.14,1450);tone(1720,.10,'triangle',.07,880,.025)},\n  break(){noise(.25,.2,.48);tone(92,.27,'sawtooth',.16,33);tone(510,.12,'square',.05,120)},\n  hurt(){tone(145,.18,'sawtooth',.1,55);noise(.1,.09,.7)},\n  jump(){tone(180,.09,'triangle',.035,300)}\n};\nmuteBtn.onclick=()=>{\n  muted=!muted;muteBtn.textContent='声音：'+(muted?'关':'开');\n  if(!muted)audioInit();\n  if(master)master.gain.value=muted?0:.32;\n};\n\nfunction makePlayer(){\n  return {x:WORLD/2,y:0,vx:0,vy:0,facing:1,hp:100,maxHp:100,state:'normal',t:0,attack:null,\n    grounded:true,invul:0,dashCd:0,parryCd:0,combo:0,comboTimer:0,charge:0,airAttack:false,\n    queued:false,run:0,landSpeed:0};\n}\nfunction limb(name,hp=2.2){return{name,alive:true,hp};}\nfunction makeEnemy(type,x){\n  const ronin=type==='ronin';\n  return{id:nextId++,type,x,y:0,vx:0,vy:0,facing:x<player.x?1:-1,\n    hp:ronin?86:72,maxHp:ronin?86:72,state:'idle',t:0,cooldown:rand(.35,.85),dead:false,deathT:0,\n    flash:0,attacked:false,attackType:'',limbs:ronin?[limb('sword'),limb('guard')]:[limb('bladeA',2),limb('bladeB',2)],\n    phase:Math.random()*6.28};\n}\nfunction livingEnemies(){let n=0;for(const e of enemies)if(!e.dead)n++;return n;}\nfunction spawn(type,side){\n  let x=player.x+side*rand(Math.min(W*.42,430),Math.min(W*.64,650));\n  x=clamp(x,100,WORLD-100);\n  if(Math.abs(x-player.x)<250)x=clamp(player.x+side*300,100,WORLD-100);\n  enemies.push(makeEnemy(type,x));\n  addFx('portal',x,0,{max:.6,color:type==='ronin'?'#ff4f66':'#ff9b4b'});\n}\nfunction resetGame(started=true){\n  player=makePlayer();enemies=[];parts=[];fx=[];camera=clamp(player.x-W/2,0,Math.max(0,WORLD-W));\n  shake=0;hitStop=0;kills=0;wave=1;spawnTimer=1;stats.hitCount=0;stats.limbBreakCount=0;\n  playerAlive=true;playing=started;\n  if(started){\n    spawn('ronin',1);spawn('mantis',-1);\n    overlay.classList.add('hidden');\n    canvas.focus();\n  }\n}\nfunction showDeath(){\n  playing=false;\n  titleEl.textContent='链接断裂';\n  subEl.textContent='COMBAT BODY OFFLINE';\n  descEl.innerHTML=`击破 ${kills} 个绯铁人偶　·　命中 ${stats.hitCount} 次　·　断肢 ${stats.limbBreakCount} 次<br>按 R 或 ENTER 立即重启`;\n  startBtn.textContent='重新接入';\n  promptEl.textContent='敌人会重新部署';\n  overlay.classList.remove('hidden');\n}\nfunction startGame(){\n  audioInit();\n  titleEl.textContent='断界';subEl.textContent='RIFT SEVER / COMBAT PROTOCOL';\n  startBtn.textContent='进入战斗';\n  resetGame(true);\n}\nstartBtn.onclick=startGame;\n\nconst gameCodes=new Set(['KeyA','KeyD','ArrowLeft','ArrowRight','Space','KeyJ','KeyK','KeyL','KeyI','KeyR','Enter']);\naddEventListener('keydown',e=>{\n  if(gameCodes.has(e.code))e.preventDefault();\n  audioInit();\n  if(e.repeat){keys[e.code]=true;return;}\n  keys[e.code]=true;\n  if(e.code==='Enter'&&!playing){startGame();return;}\n  if(e.code==='KeyR'){startGame();return;}\n  if(!playing||!playerAlive)return;\n  if(e.code==='Space')jump();\n  else if(e.code==='KeyJ')pressLight();\n  else if(e.code==='KeyK')pressHeavy();\n  else if(e.code==='KeyL')dash();\n  else if(e.code==='KeyI')parry();\n},{passive:false});\naddEventListener('keyup',e=>{\n  if(gameCodes.has(e.code))e.preventDefault();\n  keys[e.code]=false;\n  if(e.code==='KeyK'&&playing&&player&&player.state==='charge')releaseHeavy();\n},{passive:false});\naddEventListener('blur',()=>{\n  for(const k in keys)keys[k]=false;\n  if(player&&player.state==='charge'){player.state='normal';player.charge=0;}\n});\n\nfunction jump(){\n  const p=player;\n  const canGround=p.y<=1;\n  const cancelAttack=p.state==='attack'&&p.attack&&p.attack.t>p.attack.a1;\n  if(canGround&&(p.state==='normal'||p.state==='charge'||cancelAttack)){\n    p.state='normal';p.attack=null;p.charge=0;p.vy=585;p.y=2;p.grounded=false;p.airAttack=false;\n    addDust(p.x,0,5,'#72dff1');SFX.jump();\n  }\n}\nfunction pressLight(){\n  const p=player;\n  if(p.state==='normal'){\n    if(p.y>2)startAttack('air',1);else startAttack('light',1);\n  }else if(p.state==='attack'&&p.attack&&p.attack.kind==='light'&&p.attack.stage<3){\n    p.queued=true;\n  }\n}\nfunction pressHeavy(){\n  const p=player;\n  if(p.state==='normal'){\n    if(p.y>2){p.charge=.22;releaseHeavy();}\n    else{p.state='charge';p.t=0;p.charge=0;p.vx*=.35;tone(125,.12,'triangle',.04,180);}\n  }\n}\nfunction releaseHeavy(){\n  if(player.state!=='charge')return;\n  startAttack('heavy',1,player.charge);\n}\nfunction dash(){\n  const p=player;\n  if(p.dashCd>0||p.state==='dead')return;\n  let dir=(keys.KeyA||keys.ArrowLeft)?-1:(keys.KeyD||keys.ArrowRight)?1:p.facing;\n  p.facing=dir;p.state='dash';p.t=.18;p.dashCd=.58;p.invul=Math.max(p.invul,.28);p.attack=null;p.queued=false;\n  p.vx=dir*760;p.vy*=.15;\n  for(let i=0;i<5;i++)addFx('after',p.x-i*dir*15,p.y,{max:.23,face:dir});\n  addDust(p.x,0,8,'#55e9ff');SFX.dash();\n}\nfunction parry(){\n  const p=player;\n  if(p.parryCd>0||p.state==='dash'||p.state==='hurt'||p.state==='dead')return;\n  if(p.state==='attack'&&p.attack.t<p.attack.a1)return;\n  p.state='parry';p.t=0;p.parryCd=.72;p.attack=null;p.queued=false;p.vx*=.25;\n  tone(470,.06,'triangle',.025,620);\n}\nfunction attackData(kind,stage,q=0){\n  if(kind==='air')return{kind,stage:1,dur:.43,a0:.08,a1:.22,range:100,dmg:14,knock:160,lift:65,stop:.048,limb:.72,strong:false};\n  if(kind==='heavy')return{kind,stage:1,dur:.69,a0:.22,a1:.37,range:120+q*24,dmg:22+q*24,knock:260+q*180,lift:q>.72?190:90,stop:.072+q*.04,limb:1.4+q*2.2,strong:q>.45,charge:q};\n  const a=[\n    {dur:.33,a0:.075,a1:.16,range:82,dmg:10,knock:85,lift:20,stop:.032,limb:.45},\n    {dur:.36,a0:.085,a1:.19,range:96,dmg:11,knock:120,lift:50,stop:.042,limb:.65},\n    {dur:.50,a0:.13,a1:.27,range:116,dmg:19,knock:270,lift:270,stop:.078,limb:1.45,strong:true}\n  ][stage-1];\n  return Object.assign({kind:'light',stage},a);\n}\nfunction startAttack(kind,stage,q=0){\n  const p=player,a=attackData(kind,stage,q);\n  p.state='attack';p.attack=a;a.t=0;a.hit=new Set();a.fx=false;p.t=0;p.queued=false;\n  if(kind==='light'&&stage<3)p.vx+=p.facing*(stage===1?70:45);\n  if(kind==='heavy')p.vx+=p.facing*(90+q*80);\n}\nfunction addFx(type,x,y,o={}){\n  fx.push(Object.assign({type,x,y,t:0,max:.35,vx:0,vy:0,color:'#fff',size:1},o));\n}\nfunction addDust(x,y,n,color){\n  for(let i=0;i<n;i++)addFx('dust',x+rand(-12,12),y,{max:rand(.25,.55),vx:rand(-100,100),vy:rand(30,140),size:rand(2,7),color});\n}\nfunction addSparks(x,y,n,color='#fff1a0',power=1){\n  for(let i=0;i<n;i++)addFx('spark',x,y,{max:rand(.12,.38),vx:rand(-260,260)*power,vy:rand(-100,330)*power,size:rand(1,3.2),color});\n}\nfunction slashFx(x,y,face,big,color='#c9fbff'){\n  addFx('slash',x,y,{max:big?.24:.16,face,size:big?1.35:1,color,big});\n}\nfunction limbAlive(e,name){const l=e.limbs.find(x=>x.name===name);return !!(l&&l.alive);}\nfunction aliveLimbCount(e){return e.limbs.reduce((n,l)=>n+(l.alive?1:0),0);}\n\nfunction attackHits(){\n  const p=player,a=p.attack;\n  if(!a||a.t<a.a0||a.t>a.a1)return;\n  if(!a.fx){\n    a.fx=true;slashFx(p.x+p.facing*(a.range*.47),p.y+50,p.facing,a.strong||a.stage===3,a.kind==='heavy'?'#fff2b0':'#c9fbff');\n    SFX.swing(a.kind==='heavy'?0.65:1);\n  }\n  for(const e of enemies){\n    if(e.dead||a.hit.has(e.id))continue;\n    const front=(e.x-p.x)*p.facing;\n    const vertical=Math.abs((p.y+45)-(e.y+39));\n    if(front>-22&&front<a.range&&vertical<78){\n      a.hit.add(e.id);\n      damageEnemy(e,a,p.facing);\n    }\n  }\n}\nfunction damageEnemy(e,a,dir){\n  if(e.dead)return;\n  stats.hitCount++;player.combo++;player.comboTimer=1.35;\n  e.hp-=a.dmg;e.flash=.11;e.vx=dir*a.knock;e.vy=Math.max(e.vy,a.lift||0);\n  e.state='hurt';e.t=a.strong?.32:.19;e.attacked=true;\n  const hx=e.x-dir*5,hy=e.y+45;\n  addSparks(hx,hy,a.strong?16:9,a.strong?'#fff0a1':'#ff8568',a.strong?1.3:1);\n  addFx('ring',hx,hy,{max:a.strong?.30:.19,size:a.strong?1.5:1,color:a.strong?'#fff4bd':'#ff6c65'});\n  hitStop=Math.max(hitStop,a.stop);shake=Math.max(shake,a.strong?8:a.stage===3?6:3);\n  SFX.hit(!!a.strong||a.stage===3);\n  let target=null;\n  if(e.type==='ronin'){\n    target=e.limbs.find(l=>l.alive&&l.name==='sword')||e.limbs.find(l=>l.alive);\n  }else{\n    const live=e.limbs.filter(l=>l.alive);target=live[(stats.hitCount+e.id)%Math.max(1,live.length)];\n  }\n  if(target){\n    target.hp-=a.limb;\n    if(target.hp<=0)breakLimb(e,target,dir);\n  }\n  if(e.hp<=0)killEnemy(e,dir);\n}\nfunction breakLimb(e,l,dir){\n  if(!l.alive)return;\n  l.alive=false;stats.limbBreakCount++;\n  const kind=e.type==='ronin'?(l.name==='sword'?'swordArm':'arm'):'mantisBlade';\n  parts.push({kind,x:e.x+dir*9,y:e.y+48,vx:dir*rand(180,330),vy:rand(300,470),rot:rand(-1,1),vr:rand(-10,10),life:8,color:e.type==='ronin'?'#c94959':'#e17b3e'});\n  addSparks(e.x,e.y+52,24,'#ffb15c',1.5);\n  addFx('break',e.x,e.y+48,{max:.55,size:1.5,color:'#ff744f'});\n  hitStop=Math.max(hitStop,.115);shake=Math.max(shake,11);SFX.break();\n  e.cooldown+=.28;\n}\nfunction killEnemy(e,dir){\n  if(e.dead)return;\n  e.dead=true;e.deathT=.85;e.vx=dir*260;e.vy=Math.max(e.vy,250);kills++;\n  wave=1+Math.floor(kills/5);spawnTimer=Math.min(spawnTimer,.45);\n  addFx('death',e.x,e.y+42,{max:.65,size:1.2,color:e.type==='ronin'?'#ff536c':'#ff934b'});\n  addSparks(e.x,e.y+42,15,'#ff725b',1.2);\n}\nfunction enemyStrike(e,range,damage,power){\n  if(e.attacked||e.dead)return false;\n  const p=player,dx=p.x-e.x;\n  if(Math.abs(dx)<=range&&Math.abs((p.y+38)-(e.y+38))<68){\n    e.attacked=true;\n    if(p.state==='parry'&&p.t>=.025&&p.t<=.205){parryEnemy(e);return true;}\n    if(p.invul>0)return false;\n    hurtPlayer(damage,e.facing*power);return true;\n  }\n  return false;\n}\nfunction parryEnemy(e){\n  const p=player;\n  p.state='counter';p.t=.34;p.invul=.42;p.vx=0;\n  e.state='hurt';e.t=.65;e.vx=-e.facing*330;e.vy=190;\n  const a={dmg:23,knock:330,lift:190,stop:.105,limb:2.45,strong:true,stage:0};\n  damageEnemy(e,a,-e.facing);\n  hitStop=Math.max(hitStop,.12);shake=Math.max(shake,7);\n  slashFx(e.x,e.y+48,-e.facing,true,'#83ffff');\n  addFx('parry',p.x+p.facing*30,p.y+51,{max:.35,size:1.4,color:'#aaffff'});\n  SFX.parry();\n}\nfunction hurtPlayer(dmg,force){\n  const p=player;if(p.invul>0||!playerAlive)return;\n  p.hp=Math.max(0,p.hp-dmg);p.state='hurt';p.t=.32;p.attack=null;p.queued=false;p.charge=0;\n  p.vx=force;p.vy=180;p.invul=.9;p.combo=0;p.comboTimer=0;\n  hitStop=Math.max(hitStop,.06);shake=Math.max(shake,7);\n  addSparks(p.x,p.y+45,12,'#74e8ff',1.1);addFx('ring',p.x,p.y+45,{max:.25,color:'#60dfff'});\n  SFX.hurt();\n  if(p.hp<=0){\n    playerAlive=false;p.state='dead';p.t=1;p.vx=force*1.25;p.vy=300;\n    setTimeout(()=>{if(!playerAlive)showDeath();},700);\n  }\n}\n\nfunction updatePlayer(dt){\n  const p=player;\n  p.invul=Math.max(0,p.invul-dt);p.dashCd=Math.max(0,p.dashCd-dt);p.parryCd=Math.max(0,p.parryCd-dt);\n  if(p.comboTimer>0){p.comboTimer-=dt;if(p.comboTimer<=0)p.combo=0;}\n  const left=keys.KeyA||keys.ArrowLeft,right=keys.KeyD||keys.ArrowRight,move=(right?1:0)-(left?1:0);\n  if(p.state==='normal'){\n    if(move)p.facing=move;\n    const speed=p.y>1?275:255,acc=p.y>1?850:1900;\n    p.vx=approach(p.vx,move*speed,acc*dt);\n  }else if(p.state==='charge'){\n    p.t+=dt;p.charge=clamp(p.charge+dt/1.05,0,1);\n    if(move){p.facing=move;p.vx=approach(p.vx,move*72,700*dt);}else p.vx=approach(p.vx,0,850*dt);\n    if(Math.random()<dt*(4+p.charge*12))addFx('charge',p.x+rand(-25,25),p.y+rand(12,72),{max:.3,vy:80,size:1+p.charge*2,color:p.charge>.7?'#ffe58b':'#6deaff'});\n  }else if(p.state==='attack'){\n    const a=p.attack;a.t+=dt;p.t=a.t;\n    attackHits();\n    if(a.kind==='air')p.vy=Math.max(p.vy,-210);\n    p.vx=approach(p.vx,0,(a.kind==='heavy'?550:390)*dt);\n    if(a.t>=a.dur){\n      if(a.kind==='light'&&p.queued&&a.stage<3)startAttack('light',a.stage+1);\n      else{p.state='normal';p.attack=null;p.queued=false;}\n    }\n  }else if(p.state==='dash'){\n    p.t-=dt;p.vx=p.facing*760;\n    if(p.t<=0){p.state='normal';p.vx=p.facing*230;}\n  }else if(p.state==='parry'){\n    p.t+=dt;p.vx=approach(p.vx,0,1500*dt);\n    if(p.t>.43)p.state='normal';\n  }else if(p.state==='counter'){\n    p.t-=dt;p.vx=0;\n    if(p.t<=0)p.state='normal';\n  }else if(p.state==='hurt'){\n    p.t-=dt;p.vx=approach(p.vx,0,420*dt);\n    if(p.t<=0)p.state='normal';\n  }else if(p.state==='dead'){\n    p.t-=dt;p.vx=approach(p.vx,0,280*dt);\n  }\n  if(p.state!=='dash'){\n    p.vy-=1750*dt;\n  }\n  const oldY=p.y;p.x+=p.vx*dt;p.y+=p.vy*dt;p.x=clamp(p.x,55,WORLD-55);\n  if(p.y<=0){\n    if(oldY>10&&p.vy<-250){addDust(p.x,0,Math.min(12,4+Math.floor(-p.vy/100)),'#7bd6df');shake=Math.max(shake,Math.min(4,-p.vy/180));}\n    p.y=0;p.vy=0;p.grounded=true;p.airAttack=false;\n  }else p.grounded=false;\n  p.run+=Math.abs(p.vx)*dt*.035;\n}\nfunction updateEnemy(e,dt){\n  if(e.flash>0)e.flash-=dt;\n  if(e.dead){\n    e.deathT-=dt;e.vy-=1500*dt;e.x+=e.vx*dt;e.y+=e.vy*dt;e.vx*=Math.pow(.1,dt);\n    if(e.y<0){e.y=0;e.vy=0;}return;\n  }\n  e.cooldown-=dt;\n  if(e.state==='hurt'){\n    e.t-=dt;\n    if(e.t<=0)e.state='idle';\n  }else if(e.type==='ronin')updateRonin(e,dt);\n  else updateMantis(e,dt);\n  e.vy-=1600*dt;e.x+=e.vx*dt;e.y+=e.vy*dt;\n  if(e.y<=0){if(e.y<0&&e.vy<-260)addDust(e.x,0,5,'#b45a51');e.y=0;e.vy=0;}\n  e.x=clamp(e.x,55,WORLD-55);\n}\nfunction updateRonin(e,dt){\n  const d=player.x-e.x,ad=Math.abs(d),sword=limbAlive(e,'sword'),arms=aliveLimbCount(e);\n  if(e.state==='idle'){\n    if(ad>12)e.facing=d>0?1:-1;\n    if(e.y>2){e.vx*=.98;return;}\n    if(e.cooldown<=0&&ad<(sword?125:78)){\n      e.state='windup';e.t=sword?(arms===2?.46:.61):.57;e.vx=0;e.attackType=sword?'slash':'kick';e.attacked=false;\n    }else{\n      const desired=ad>(sword?82:58)?e.facing*(arms?112:82):0;\n      e.vx=approach(e.vx,desired,650*dt);\n    }\n  }else if(e.state==='windup'){\n    e.t-=dt;e.vx=approach(e.vx,0,900*dt);\n    if(e.t<=0){e.state='attack';e.t=e.attackType==='slash'?.18:.2;e.attacked=false;SFX.swing(.75);}\n  }else if(e.state==='attack'){\n    if(!e.attacked)enemyStrike(e,e.attackType==='slash'?91:59,e.attackType==='slash'?(aliveLimbCount(e)>1?14:10):8,e.attackType==='slash'?330:240);\n    e.vx=e.facing*(e.attackType==='slash'?170:125);e.t-=dt;\n    if(e.t<=0){e.state='recover';e.t=e.attackType==='slash'?.38:.45;e.cooldown=rand(.55,.9);e.vx*=.2;}\n  }else if(e.state==='recover'){\n    e.t-=dt;e.vx=approach(e.vx,0,700*dt);if(e.t<=0)e.state='idle';\n  }\n}\nfunction updateMantis(e,dt){\n  const d=player.x-e.x,ad=Math.abs(d),blades=aliveLimbCount(e);\n  if(e.state==='idle'){\n    e.facing=d>0?1:-1;\n    if(e.y>2){e.vx*=.99;return;}\n    if(e.cooldown<=0&&ad<390){\n      e.state='windup';e.t=blades?.58:.75;e.vx=0;e.attacked=false;e.attackType=blades?'pounce':'ram';\n    }else{\n      let desired=0;if(ad>245)desired=e.facing*145;else if(ad<135)desired=-e.facing*90;\n      e.vx=approach(e.vx,desired,780*dt);\n    }\n  }else if(e.state==='windup'){\n    e.t-=dt;e.vx=approach(e.vx,0,1100*dt);\n    if(e.t<=0){\n      e.state='leap';e.t=blades?.48:.42;e.attacked=false;e.vx=e.facing*(blades?530:390);e.vy=blades?230:120;\n      SFX.dash();\n    }\n  }else if(e.state==='leap'){\n    if(!e.attacked)enemyStrike(e,blades?64:50,blades?12+blades*2:8,blades?390:270);\n    e.t-=dt;if(e.t<=0){e.state='recover';e.t=.5;e.cooldown=rand(.75,1.15);e.vx*=.25;}\n  }else if(e.state==='recover'){\n    e.t-=dt;e.vx=approach(e.vx,0,800*dt);if(e.t<=0)e.state='idle';\n  }\n}\nfunction updateParts(dt){\n  for(const p of parts){\n    p.life-=dt;p.vy-=1300*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.rot+=p.vr*dt;p.vx*=Math.pow(.28,dt);\n    if(p.y<0){p.y=0;if(Math.abs(p.vy)>90){p.vy=-p.vy*.3;p.vr*=.7;addDust(p.x,0,2,'#a85b50');}else p.vy=0;}\n  }\n  parts=parts.filter(p=>p.life>0);\n}\nfunction updateFx(dt){\n  for(const f of fx){f.t+=dt;f.x+=f.vx*dt;f.y+=f.vy*dt;if(f.type==='spark'||f.type==='dust')f.vy-=520*dt;}\n  fx=fx.filter(f=>f.t<f.max);\n}\nfunction update(dt){\n  clock+=dt;\n  if(!playing)return;\n  updatePlayer(dt);\n  if(playerAlive)for(const e of enemies)updateEnemy(e,dt);\n  updateParts(dt);updateFx(dt);\n  enemies=enemies.filter(e=>!e.dead||e.deathT>0);\n  if(playerAlive){\n    spawnTimer-=dt;\n    const cap=Math.min(5,2+Math.floor(kills/4));\n    if(livingEnemies()<cap&&spawnTimer<=0){\n      const side=(Math.random()<.5?-1:1);\n      spawn((kills+livingEnemies()+Math.floor(clock))%3===0?'mantis':'ronin',side);\n      spawnTimer=rand(.55,1.1);\n    }\n  }\n  const target=clamp(player.x-W*.5+player.facing*55,0,Math.max(0,WORLD-W));\n  camera=lerp(camera,target,1-Math.pow(.0008,dt));\n  shake=Math.max(0,shake-dt*18);\n}\n\nfunction line(x1,y1,x2,y2,w,color){\n  ctx.strokeStyle=color;ctx.lineWidth=w;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(x1,y1);ctx.lineTo(x2,y2);ctx.stroke();\n}\nfunction poly(points,fill,stroke=null,w=1){\n  ctx.beginPath();ctx.moveTo(points[0][0],points[0][1]);for(let i=1;i<points.length;i++)ctx.lineTo(points[i][0],points[i][1]);ctx.closePath();\n  ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=w;ctx.stroke();}\n}\nfunction drawBackground(){\n  const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#050814');g.addColorStop(.58,'#101729');g.addColorStop(1,'#17121b');\n  ctx.fillStyle=g;ctx.fillRect(0,0,W,H);\n  ctx.save();ctx.globalAlpha=.72;\n  const mx=W*.77-camera*.025,my=H*.22,r=Math.min(105,H*.14);\n  const mg=ctx.createRadialGradient(mx-20,my-20,5,mx,my,r);mg.addColorStop(0,'#e9fcff');mg.addColorStop(.18,'#78b4c5');mg.addColorStop(.6,'#243c52');mg.addColorStop(1,'rgba(14,24,42,0)');\n  ctx.fillStyle=mg;ctx.beginPath();ctx.arc(mx,my,r,0,7);ctx.fill();ctx.restore();\n  for(const s of stars){\n    let x=(s.x-camera*.055)%(W+100);if(x<0)x+=W+100;\n    ctx.globalAlpha=s.a*(.75+.25*Math.sin(clock*1.7+s.x));\n    ctx.fillStyle='#9de8ff';ctx.fillRect(x,s.y%Math.max(80,H*.55),s.r,s.r);\n  }\n  ctx.globalAlpha=1;\n  ctx.save();ctx.translate(-(camera*.16)%260,0);\n  for(let i=-2;i<W/130+4;i++){\n    const x=i*130,y=ground-120-(i%3)*35;\n    ctx.fillStyle=i%2?'#11192a':'#0d1525';ctx.fillRect(x,y,95,ground-y);\n    ctx.fillStyle='#183047';for(let k=0;k<3;k++)ctx.fillRect(x+15+k*23,y+20+(k%2)*19,5,14);\n    ctx.strokeStyle='rgba(67,1