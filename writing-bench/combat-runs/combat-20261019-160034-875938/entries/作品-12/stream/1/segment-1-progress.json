==='shot'?.88:a.kind==='rush'?.62:.5)+(e.leg?0:.14);\n if(a.t>=wind)return;\n let t=a.t/wind;\n ctx.save();ctx.globalAlpha=.15+t*.2;\n if(a.kind==='shot'){\n  const sx=e.x+e.dir*38,sy=e.y-54;\n  line(sx,sy,a.aim,p.y-44,'#ffb36b',1);\n  ctx.setLineDash([5,9]);line(sx,sy,a.aim,p.y-44,'#ffca80',2);ctx.setLineDash([]);\n  ctx.globalAlpha=.5;circle(a.aim,p.y-44,5,'#efad66');\n }else{\n  let x=e.x+e.dir*60;\n  ctx.fillStyle='#f5a65e';ctx.beginPath();ctx.ellipse(x,FLOOR-1,64*t+20,5,0,0,TAU);ctx.fill();\n  ctx.globalAlpha=.75;line(e.x-22,e.y-101,e.x-22+44*t,e.y-101,'#ffc883',2);\n }\n ctx.restore();\n}\nfunction drawSlash(s){\n let t=s.t/s.life,heavy=s.type==='heavy',r=heavy?151:s.type==='launch'?112:s.stage===3?138:117;\n ctx.save();ctx.translate(s.x,s.y);ctx.scale(s.dir,s.type==='launch'?1.12:.76);\n if(s.stage===2)ctx.scale(1,-1);\n ctx.globalAlpha=(1-t)*.85;\n const begin=s.type==='launch'?-2.8:-1.6,end=1.05;\n let endNow=lerp(begin+.35,end,Math.min(1,t*3+.4));\n ctx.rotate(s.type==='launch'?-.5:.04);\n let grad=ctx.createRadialGradient(0,0,r*.5,0,0,r+12);grad.addColorStop(0,heavy?'#ffe1a000':'#7efbe200');grad.addColorStop(.75,heavy?'#e8a25040':'#5bddc55a');grad.addColorStop(1,heavy?'#fff1c4':'#baffee');\n ctx.fillStyle=grad;ctx.beginPath();ctx.arc(0,0,r,begin,endNow);ctx.arc(0,0,r*.55,endNow,begin,true);ctx.closePath();ctx.fill();\n ctx.strokeStyle=heavy?'#fff3c2':'#e4fff5';ctx.lineWidth=heavy?4:2;ctx.beginPath();ctx.arc(0,0,r,begin+.13,endNow);ctx.stroke();\n ctx.strokeStyle=heavy?'#e6ad5f':'#75cbb9';ctx.lineWidth=1;ctx.beginPath();ctx.arc(0,0,r+9,begin+.2,endNow-.08);ctx.stroke();\n ctx.restore();\n}\nfunction drawWorld(){\n ctx.save();\n const sx=shake?Math.sin(clock*97)*shake:0,sy=shake?Math.cos(clock*117)*shake*.55:0;\n ctx.translate(sx,sy);drawBackdrop();\n ctx.translate(-camera,0);\n for(const e of enemies)shadow(e.x,e.y,e.type==='gun'?32:27);\n shadow(p.x,p.y,30);\n for(const e of enemies)drawTelegraph(e);\n for(const d of debris){\n  ctx.save();ctx.globalAlpha