  "text": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>断流 / SEVER — 战斗试炼</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#0a1119;color:#e9eee9;font-family:Inter,\"Microsoft YaHei\",sans-serif;user-select:none}canvas{display:block;width:100%;height:100%;outline:none}button{font:inherit;cursor:pointer;color:#d9e7e5;border:1px solid #49605f;background:#102026d9;transition:.2s}button:hover{background:#21403f;border-color:#81e6d2}button:focus-visible{outline:2px solid #9fffe4;outline-offset:4px}.tools{position:absolute;right:24px;top:22px;display:flex;gap:8px}.tools button{font-size:12px;padding:9px 14px;letter-spacing:1px}.veil{position:absolute;inset:0;display:flex;align-items:center;padding:6vw;background:linear-gradient(90deg,rgba(6,14,21,.96),rgba(6,14,21,.72) 48%,rgba(6,14,21,.06) 100%)}.hidden{display:none!important}.card{max-width:650px}.eyebrow{font-size:12px;letter-spacing:5px;color:#82d9c9;margin-bottom:14px}.card h1{font-size:clamp(62px,8vw,116px);font-weight:800;letter-spacing:10px;line-height:1;margin:12px 0 14px}.card h1 span{font-weight:200;color:#74d9c5}.subtitle{letter-spacing:7px;color:#a4b8b9;font-size:15px}.rule{height:1px;background:linear-gradient(90deg,#74d9c5,transparent);margin:25px 0}.copy{font-size:15px;line-height:1.9;color:#b5c5c7;max-width:510px}.copy strong{color:#e5ba79;font-weight:500}.start{display:inline-flex;align-items:center;gap:50px;margin:22px 0 16px;background:#99e4d0;color:#101f24;border:0;padding:16px 27px;font-size:17px;font-weight:700;letter-spacing:3px}.start:hover{color:white;background:#2c8278}.start small{font-size:11px;letter-spacing:2px;font-weight:500}.tip{font-size:11px;letter-spacing:2px;color:#7c959b}.endveil{justify-content:center;text-align:center;background:#071018c4;padding:20px}.endveil h1{font-size:56px;letter-spacing:8px}.endveil .eyebrow{margin-bottom:25px}.endveil .start{gap:25px}.pause{position:absolute;left:50%;top:42%;transform:translate(-50%,-50%);background:#101d26ed;border:1px solid #537577;padding:22px 38px;letter-spacing:3px;text-align:center;pointer-events:none}.pause small{display:block;color:#8ba4a6;font-size:11px;margin-top:12px;letter-spacing:1px}@media(max-height:600px){.card h1{font-size:66px}.rule{margin:16px 0}.copy{font-size:13px}.start{padding:13px 23px;margin-top:12px}.tools{top:15px;right:15px}}\n</style>\n</head>\n<body>\n<canvas id=\"game\" tabindex=\"0\" aria-label=\"断流，横版动作战斗场景\"></canvas>\n<div class=\"tools\"><button id=\"mute\" aria-label=\"切换静音\">声音 ON</button><button id=\"reset\">重启 R</button></div>\n<div id=\"intro\" class=\"veil\">\n <div class=\"card\">\n  <div class=\"eyebrow\">KINETIC COMBAT / 01</div>\n  <h1>断<span>流</span></h1>\n  <div class=\"subtitle\">SEVER · 铸偶庭院</div>\n  <div class=\"rule\"></div>\n  <div class=\"copy\">刀锋不止于击倒。<strong>切断武装，改变战局。</strong><br>连斩压制，蓄刃破体；挑空之后，在空中续写连段。<br>观察橙色预兆，用闪步穿过攻击。没有终点，只有下一刀。</div>\n  <button class=\"start\" id=\"start\">进入试炼 <small>ENTER ↵</small></button>\n  <div class=\"tip\">J 连斩 · 按住 K 蓄刃 · L 闪步 · I 挑空</div>\n </div>\n</div>\n<div id=\"death\" class=\"veil endveil hidden\"><div class=\"card\"><div class=\"eyebrow\">SIGNAL LOST / 信号中断</div><h1>刃犹未冷</h1><div id=\"result\" class=\"copy\"></div><button id=\"again\" class=\"start\">再战一次 <small>R / ENTER ↵</small></button></div></div>\n<div id=\"pause\" class=\"pause hidden\">试炼暂停<small>点击场景或按任意操作键继续</small></div>\n<script>\n(()=>{\n'use strict';\nconst canvas=document.getElementById('game'),ctx=canvas.getContext('2d');\nconst $=id=>document.getElementById(id);\nlet W=1280,H=720,DPR=1;\nfunction resize(){DPR=Math.min(window.devicePixelRatio||1,2);W=innerWidth/innerHeight*720;H=720;canvas.width=Math.round(innerWidth*DPR);canvas.height=Math.round(innerHeight*DPR)}\naddEventListener('resize',resize);resize();\nconst FLOOR=582,WORLD=2600,TAU=Math.PI*2;\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),rand=(a,b)=>a+Math.random()*(b-a),lerp=(a,b,t)=>a+(b-a)*t;\nlet audio=null,noiseBuf=null,muted=false;\nfunction unlock(){\n try{if(!audio){audio=new (window.AudioContext||window.webkitAudioContext)();noiseBuf=audio.createBuffer(1,audio.sampleRate*.4,audio.sampleRate);let d=noiseBuf.getChannelData(0);for(let i=0;i<d.length;i++)d[i]=Math.random()*2-1}if(audio.state==='suspended')audio.resume().catch(()=>{})}catch(e){}\n}\nfunction tone(f,end,len,vol,type='sine',delay=0){\n if(!audio||muted)return;try{let t=audio.currentTime+delay,o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.setValueAtTime(f,t);o.frequency.exponentialRampToValueAtTime(Math.max(end,20),t+len);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(Math.max(vol,.001),t+.005);g.gain.exponentialRampToValueAtTime(.0001,t+len);o.connect(g);g.connect(audio.destination);o.start(t);o.stop(t+len+.02)}catch(e){}\n}\nfunction noise(len,vol,freq=2000,type='bandpass'){\n if(!audio||muted||!noiseBuf)return;try{let t=audio.currentTime,n=audio.createBufferSource(),f=audio.createBiquadFilter(),g=audio.createGain();n.buffer=noiseBuf;f.type=type;f.frequency.value=freq;f.Q.value=.8;g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.001,t+len);n.connect(f);f.connect(g);g.connect(audio.destination);n.start(t);n.stop(t+len)}catch(e){}\n}\nfunction sound(k,p=1){\n if(k==='swing'){noise(.1,.12,3000);tone(370,100,.09,.035,'triangle')}\n if(k==='heavy'){noise(.19,.23,1100);tone(190,38,.18,.15,'triangle')}\n if(k==='hit'){tone(160+p*30,48,.12,.13,'triangle');tone(1200,380,.06,.045);noise(.075,.19,2300)}\n if(k==='break'){noise(.25,.28,1300);tone(90,26,.25,.19,'sawtooth');tone(1300,230,.15,.05)}\n if(k==='dash'){noise(.15,.15,2500,'highpass');tone(260,70,.12,.04)}\n if(k==='jump'){tone(190,440,.1,.035,'triangle')}\n if(k==='hurt'){noise(.16,.19,650);tone(90,35,.22,.17,'sawtooth')}\n if(k==='shot'){noise(.12,.16,1700);tone(220,65,.12,.08,'square')}\n if(k==='ready'){tone(600,900,.12,.04);tone(900,1400,.18,.04,'sine',.1)}\n}\n$('mute').onclick=()=>{unlock();muted=!muted;$('mute').textContent=muted?'声音 OFF':'声音 ON'};\nlet keys=Object.create(null),buf={},p,enemies=[],particles=[],debris=[],slashes=[],texts=[],shots=[],ghosts=[];\nlet playing=false,paused=false,ready=false,wave=1,kills=0,hitCount=0,limbBreakCount=0,combo=0,best=0,comboClock=0;\nlet camera=0,shake=0,freeze=0,clock=0,flashHurt=0,waveWait=0,waveBanner=0,uid=0;\nfunction clearInput(){keys=Object.create(null);buf={}}\nfunction makePlayer(){return {x:1100,y:FLOOR,vx:0,vy:0,dir:1,hp:100,energy:100,act:null,dashCD:0,inv:0,hurt:0,specialCD:0,jumps:0,step:0,comboStep:0,chain:0,land:0,dodgeReward:false}}\nfunction spawnEnemy(x,type){\n enemies.push({id:++uid,x:clamp(x,75,WORLD-75),y:FLOOR,vx:0,vy:0,dir:1,type,hp:type==='gun'?150:115,max:type==='gun'?150:115,arm:true,leg:true,stun:0,flash:0,act:null,wait:rand(.3,.8),step:rand(0,6),dead:0,mark:0});\n}\nfunction spawnWave(){\n const count=Math.min(3+Math.floor((wave-1)/2),6);\n for(let i=0;i<count;i++){let side=i%2===0?1:-1;let dist=240+Math.floor(i/2)*150;spawnEnemy(p.x+side*dist,(i+(wave%2))%3===0?'gun':'blade')}\n waveBanner=2.4;waveWait=0;\n}\nfunction reset(run=true){\n clearInput();p=makePlayer();enemies=[];particles=[];debris=[];slashes=[];texts=[];shots=[];ghosts=[];\n wave=1;kills=0;hitCount=0;limbBreakCount=0;combo=0;best=0;comboClock=0;freeze=0;shake=0;flashHurt=0;camera=clamp(p.x-W/2,0,Math.max(0,WORLD-W));paused=false;playing=run;spawnWave();\n $('intro').classList.toggle('hidden',run);$('death').classList.add('hidden');$('pause').classList.add('hidden');\n}\nfunction start(){unlock();if(p.hp<=0)reset(true);else{playing=true;paused=false;$('intro').classList.add('hidden');$('pause').classList.add('hidden')}canvas.focus({preventScroll:true})}\n$('start').onclick=start;$('again').onclick=()=>{unlock();reset(true);canvas.focus({preventScroll:true})};$('reset').onclick=()=>{unlock();reset(true);canvas.focus({preventScroll:true})};\nconst binds=['KeyA','KeyD','ArrowLeft','ArrowRight','Space','KeyJ','KeyK','KeyL','KeyI','KeyR','Enter','ArrowUp','ArrowDown'];\naddEventListener('keydown',e=>{\n if(binds.includes(e.code))e.preventDefault();else return;\n unlock();\n if(e.code==='KeyR'){if(!e.repeat)reset(true);return}\n if(!playing||paused){if(p.hp<=0){if(e.code==='Enter'){reset(true)}else return}else start()}\n if(e.code==='Enter')return;\n if(!keys[e.code]&&!e.repeat){\n  if(e.code==='Space')buf.jump=.2;\n  if(e.code==='KeyJ')buf.attack=.24;\n  if(e.code==='KeyK')buf.heavy=.25;\n  if(e.code==='KeyL')buf.dash=.22;\n  if(e.code==='KeyI')buf.special=.23;\n }\n keys[e.code]=true;\n},{passive:false});\naddEventListener('keyup',e=>{if(binds.includes(e.code))e.preventDefault();keys[e.code]=false},{passive:false});\nfunction loseFocus(){clearInput();if(playing){paused=true;$('pause').classList.remove('hidden')}}\naddEventListener('blur',loseFocus);document.addEventListener('visibilitychange',()=>{if(document.hidden)loseFocus()});\ncanvas.addEventListener('pointerdown',()=>{unlock();if(p.hp>0)start()});\nfunction text(x,y,s,c='#d6fff0',size=19){texts.push({x,y,s,c,size,t:0,life:.85})}\nfunction spark(x,y,n,color,power=1){\n for(let i=0;i<n;i++){let a=rand(0,TAU),s=rand(70,320)*power;particles.push({x,y,vx:Math.cos(a)*s,vy:Math.sin(a)*s-55,t:0,life:rand(.16,.46),c:color,size:rand(1,3),g:420})}\n if(particles.length>500)particles.splice(0,particles.length-500);\n}\nfunction dust(x,y,n=7){for(let i=0;i<n;i++)particles.push({x:x+rand(-15,15),y:y-2,vx:rand(-80,80),vy:rand(-50,-5),t:0,life:rand(.2,.5),c:'#829491',size:rand(2,5),g:80})}\nfunction part(x,y,len,r,color,vx,vy,angle=0){debris.push({x,y,len,r,c:color,vx,vy,a:angle,av:rand(-10,10),life:rand(3,5),t:0,b:0});if(debris.length>85)debris.shift()}\nfunction breakLimb(e,which,dir){\n if(!e[which])return;e[which]=false;limbBreakCount++;\n const yy=e.y-(which==='arm'?58:20),col=e.type==='gun'?'#c89d65':'#a8a49a';\n if(which==='arm'){\n  part(e.x+dir*10,yy,24,7,col,dir*rand(130,250),-260,-.6);\n  part(e.x+dir*25,yy+8,25,6,'#687c80',dir*rand(210,330),-210,.5);\n  part(e.x+dir*42,yy+10,e.type==='gun'?33:63,e.type==='gun'?9:3,e.type==='gun'?'#a48a61':'#d4d5b6',dir*rand(250,360),-310,-1);\n }else{\n  part(e.x,yy-8,25,8,col,dir*rand(140,240),-240,.2);\n  part(e.x+10,yy+7,25,7,'#72837f',dir*rand(190,300),-180,1.2);\n }\n spark(e.x,yy,28,'#f4b45d',1.3);text(e.x,yy-43,which==='arm'?'武装切断':'支撑切断','#ffd598',14);sound('break');shake=Math.max(shake,7);\n}\nfunction killEnemy(e,dir){\n if(e.dead)return;e.dead=.7;e.hp=0;e.act=null;kills++;e.vx=dir*180;e.vy=-150;\n spark(e.x,e.y-42,22,'#dfac62',1);\n part(e.x,e.y-77,17,9,'#c4bba2',dir*rand(100,230),-300,1);\n}\nfunction hitEnemy(e,a){\n a.hits.add(e.id);hitCount++;combo++;best=Math.max(best,combo);comboClock=3;\n const strong=a.type==='heavy'||a.type==='launch'||(a.type==='light'&&a.stage===3);\n let dmg=a.type==='light'?[0,17,20,30][a.stage]:a.type==='heavy'?Math.round(38+32*a.power):25;\n e.hp-=dmg;e.flash=.13;e.stun=strong?.48:.25;e.act=null;e.wait=.45;\n const dir=p.dir;\n e.vx=dir*(a.type==='heavy'?390:strong?265:140);\n if(a.type==='launch')e.vy=-670;else if(a.type==='heavy')e.vy=-230-100*a.power;else if(e.y<FLOOR-10)e.vy=-150;else if(a.stage===3)e.vy=-190;\n if(a.type==='heavy'){breakLimb(e,e.arm?'arm':e.leg?'leg':'arm',dir)}\n else if(a.type==='launch'&&e.leg){breakLimb(e,'leg',dir)}\n else if(a.type==='light'&&a.stage===3&&e.arm){breakLimb(e,'arm',dir)}\n p.energy=clamp(p.energy+5,0,100);\n freeze=Math.max(freeze,a.type==='heavy'?.105+a.power*.025:a.type==='launch'?.085:a.stage===3?.085:.045);\n shake=Math.max(shake,strong?6.5:3);\n spark(e.x-dir*10,e.y-45, strong?20:11,strong?'#ffd295':'#b0ffea',strong?1.15:.8);\n text(e.x+rand(-12,12),e.y-93,''+dmg,strong?'#ffe2ad':'#e9fffa',strong?24:18);\n sound('hit',strong?2:1);\n if(e.hp<=0)killEnemy(e,dir);\n}\nfunction damagePlayer(amount,dir){\n if(p.hp<=0)return;\n if(p.inv>0){\n  if(p.act&&p.act.type==='dash'&&!p.dodgeReward){p.dodgeReward=true;p.energy=clamp(p.energy+15,0,100);text(p.x,p.y-110,'擦身 · +15','#88e5d6',14);sound('ready')}\n  return;\n }\n p.hp=Math.max(0,p.hp-amount);p.inv=1.05;p.hurt=.19;p.act=null;p.vx=dir*230;p.vy=-180;flashHurt=.4;shake=7;freeze=.065;combo=0;comboClock=0;\n spark(p.x,p.y-45,16,'#ff7a60',.9);sound('hurt');\n if(p.hp<=0){playing=false;$('result').textContent=`抵达第 ${wave} 波 · 击破 ${kills} 具铸偶 · 切断 ${limbBreakCount} 处肢体 · 最长 ${best} 连击`;$('death').classList.remove('hidden');clearInput()}\n}\nfunction beginAttack(type,stage=1,power=0){\n p.act={type,stage,power,t:0,hits:new Set(),fx:false,dur:type==='light'?[0,.32,.36,.5][stage]:type==='heavy'?.64:.5};\n if(type==='light'){p.comboStep=stage;p.chain=.8}\n else{p.comboStep=0;p.chain=0}\n if(type==='launch'){p.specialCD=1.25;p.energy-=30}\n}\nfunction attackTimes(a){if(a.type==='light')return a.stage===3?[.13,.27]:a.stage===2?[.08,.2]:[.065,.17];return a.type==='heavy'?[.16,.32]:[.1,.26]}\nfunction updatePlayer(dt){\n p.dashCD=Math.max(0,p.dashCD-dt);p.specialCD=Math.max(0,p.specialCD-dt);p.inv=Math.max(0,p.inv-dt);p.hurt=Math.max(0,p.hurt-dt);p.chain-=dt;p.land=Math.max(0,p.land-dt);p.energy=Math.min(100,p.energy+dt*5);\n let move=(keys.KeyD||keys.ArrowRight?1:0)-(keys.KeyA||keys.ArrowLeft?1:0),a=p.act;\n if(a)a.t+=dt;\n const free=()=>!p.act||(['light','heavy','launch'].includes(p.act.type)&&p.act.t>p.act.dur*.63);\n if(buf.dash>0&&p.dashCD<=0){\n  buf.dash=0;if(move)p.dir=move;p.act={type:'dash',t:0,dur:.2};p.dashCD=.58;p.inv=Math.max(p.inv,.27);p.hurt=0;p.dodgeReward=false;p.vy*=.35;sound('dash');dust(p.x,p.y);\n }\n if(buf.jump>0&&p.jumps<2&&p.hurt<=0&&(!p.act||p.act.type!=='dash')){\n  buf.jump=0;p.vy=p.jumps===0?-570:-485;p.jumps++;if(p.jumps===2){spark(p.x,p.y-4,13,'#85d9cd',.5)}else dust(p.x,p.y);sound('jump');\n }\n if(p.hurt<=0&&free()){\n  if(buf.special>0&&p.specialCD<=0&&p.energy>=30){buf.special=0;if(move)p.dir=move;beginAttack('launch')}\n  else if(buf.heavy>0){buf.heavy=0;if(move)p.dir=move;p.act={type:'charge',t:0,dur:1.2,full:false};p.vx*=.35}\n  else if(buf.attack>0||keys.KeyJ){buf.attack=0;if(move)p.dir=move;let step=p.chain>0&&p.comboStep<3?p.comboStep+1:1;beginAttack('light',step)}\n }\n a=p.act;\n if(a&&a.type==='charge'){\n  if(a.t>=.65&&!a.full){a.full=true;sound('ready');spark(p.x+p.dir*8,p.y-58,10,'#ffe2a1',.45)}\n  if((!keys.KeyK&&a.t>=.15)||a.t>=1.02){let power=clamp(a.t/.68,0,1);beginAttack('heavy',1,power);a=p.act}\n }\n if(a&&['light','heavy','launch'].includes(a.type)){\n  const [on,off]=attackTimes(a);\n  if(a.t>=on&&!a.fx){\n   a.fx=true;slashes.push({x:p.x,y:p.y-46,dir:p.dir,type:a.type,stage:a.stage,t:0,life:a.type==='heavy'?.28:.2});\n   sound(a.type==='heavy'?'heavy':'swing');\n   p.vx=p.dir*(a.type==='heavy'?430:a.type==='launch'?90:a.stage===3?310:210);\n   if(a.type==='launch'){p.vy=-510;p.jumps=Math.max(p.jumps,1)}\n  }\n  if(a.t>=on&&a.t<=off){\n   const reach=a.type==='heavy'?172:a.type==='launch'?112:a.stage===3?155:133;\n   for(const e of enemies){\n    if(e.dead||a.hits.has(e.id))continue;\n    let dx=(e.x-p.x)*p.dir,dy=e.y-p.y;\n    if(dx>-31&&dx<reach&&dy>-115&&dy<(a.type==='launch'?115:85))hitEnemy(e,a);\n   }\n  }\n }\n a=p.act;\n if(a&&a.type!=='charge'&&a.t>=a.dur)p.act=null;\n a=p.act;\n if(a&&a.type==='dash'){\n  p.vx=p.dir*890;p.vy=0;\n  if(Math.random()<.75)ghosts.push({x:p.x,y:p.y,dir:p.dir,t:0,life:.19});\n }else{\n  if(p.hurt>0)p.vx*=Math.pow(.04,dt);\n  else if(!a){p.vx=lerp(p.vx,move*280,Math.min(1,dt*25));if(move)p.dir=move}\n  else if(a.type==='charge')p.vx=lerp(p.vx,move*70,dt*12);\n  else p.vx*=Math.pow(.006,dt);\n  p.vy+=1500*dt*((a&&a.type==='charge'&&p.y<FLOOR)? .4:((a&&a.type==='light'&&p.y<FLOOR&&p.vy>0)?.43:1));\n }\n p.x=clamp(p.x+p.vx*dt,38,WORLD-38);p.y+=p.vy*dt;p.step+=Math.abs(p.vx)*dt*.045;\n if(p.y>=FLOOR){if(p.vy>340){dust(p.x,FLOOR,11);p.land=.13;if(p.vy>650)shake=Math.max(shake,2)}p.y=FLOOR;p.vy=0;p.jumps=0}\n for(const k in buf)buf[k]=Math.max(0,buf[k]-dt);\n}\nfunction enem