  "text": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>断潮 · BREAKWATER</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#080f16;color:#e8eee8;font-family:Arial,\"Microsoft YaHei\",sans-serif}canvas{display:block;width:100%;height:100%}button{font:inherit;cursor:pointer;color:inherit}#sound{position:absolute;right:24px;top:22px;background:#101f28cc;border:1px solid #4a6066;padding:9px 13px;font-size:12px;letter-spacing:1px;border-radius:3px;z-index:3}#sound:hover{border-color:#74e6cf;color:#74e6cf}#keys{position:absolute;bottom:15px;left:0;width:100%;display:flex;justify-content:center;flex-wrap:wrap;gap:8px 20px;font-size:12px;color:#95aaaf;pointer-events:none;line-height:24px}kbd{font-family:inherit;display:inline-block;min-width:22px;padding:0 5px;text-align:center;color:#e3eee9;background:#172932;border:1px solid #465961;border-bottom:2px solid #63767b;border-radius:3px;margin-right:5px;font-size:11px;line-height:20px}#veil{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(90deg,#071018bb,#07101844,#071018aa);z-index:2}#card{width:560px;max-width:85vw;padding:33px 38px;border-left:2px solid #80e4ce;background:linear-gradient(100deg,#0b1925f2,#0b1925d9);box-shadow:0 20px 100px #0006}#eyebrow{font-size:11px;letter-spacing:5px;color:#80e4ce}h1{font-weight:900;letter-spacing:12px;font-size:64px;line-height:1.1;margin:20px 0 8px}#subtitle{color:#eab58d;font-size:12px;letter-spacing:5px;margin-bottom:27px}#desc{font-size:14px;line-height:1.95;color:#b2c5ca;margin:0 0 24px}#desc b{font-weight:normal;color:#eff4e7}#start{padding:13px 23px;border:0;background:#8fe5d0;color:#0b2029;font-weight:bold;letter-spacing:2px;box-shadow:4px 4px 0 #335b5c}#start:hover{background:#d4fff0}#small{display:block;color:#738e99;font-size:11px;margin-top:19px;letter-spacing:1px}@media(max-height:580px){#card{padding:23px 30px}h1{font-size:48px;margin:12px 0 6px}#subtitle{margin-bottom:14px}#desc{margin-bottom:16px;font-size:13px}#small{margin-top:12px}#keys{bottom:8px;gap:5px 13px}#sound{top:16px;right:18px}}\n</style>\n</head>\n<body>\n<canvas id=\"game\"></canvas>\n<button id=\"sound\" aria-label=\"切换静音\">声音 ON</button>\n<div id=\"veil\">\n <div id=\"card\">\n  <div id=\"eyebrow\">REEF–09 / COMBAT FIELD</div>\n  <h1 id=\"title\">断 潮</h1>\n  <div id=\"subtitle\">BREAKWATER · 废港清算</div>\n  <p id=\"desc\"><b>刀刃接上刀刃，让钢铁失去平衡。</b><br>J 连斩，K 按住蓄力断腿；第三段连斩可斩断武器臂。<br>I 挑空后接 J 追击，L 穿过攻击，精准闪避后 K 即刻满蓄力。<br>断臂的炮手会改用撞击，断腿的斩卫只能跛行。</p>\n  <button id=\"start\">ENTER / 开始战斗</button>\n  <span id=\"small\">无尽波次 · 波间修复 · R 随时重开 · 建议开启声音</span>\n </div>\n</div>\n<div id=\"keys\">\n <span><kbd>A D</kbd><kbd>← →</kbd>移动</span><span><kbd>Space</kbd>二段跳</span>\n <span><kbd>J</kbd>连斩 / 按住连击</span><span><kbd>K</kbd>重斩 / 按住蓄力</span>\n <span><kbd>L</kbd>闪避</span><span><kbd>I</kbd>挑空追击</span><span><kbd>R</kbd>重开</span>\n</div>\n<script>\n(()=>{\n'use strict';\nconst canvas=document.getElementById('game'),ctx=canvas.getContext('2d');\nconst veil=document.getElementById('veil'),soundButton=document.getElementById('sound');\nlet W=1138,H=640,G=493,world=2000,dpr=1;\nfunction resize(){dpr=Math.min(devicePixelRatio||1,2);canvas.width=Math.round(innerWidth*dpr);canvas.height=Math.round(innerHeight*dpr);W=innerWidth/innerHeight*H;world=Math.max(2000,W+480);}\naddEventListener('resize',resize);resize();\nconst clamp=(v,a,b)=>Math.max(a,Math.min(b,v)),lerp=(a,b,t)=>a+(b-a)*t;\nconst rand=(a,b)=>a+Math.random()*(b-a);\nlet audio=null,master=null,noise=null,muted=false;\nfunction unlock(){\n if(audio){if(audio.state==='suspended')audio.resume().catch(()=>{});return}\n try{const AC=window.AudioContext||window.webkitAudioContext;if(!AC)return;audio=new AC();master=audio.createGain();master.gain.value=muted?0:.24;\n const comp=audio.createDynamicsCompressor();comp.threshold.value=-19;comp.ratio.value=5;master.connect(comp);comp.connect(audio.destination);\n noise=audio.createBuffer(1,audio.sampleRate*.5,audio.sampleRate);const a=noise.getChannelData(0);for(let i=0;i<a.length;i++)a[i]=Math.random()*2-1;\n }catch(e){audio=null}\n}\nfunction tone(f,end,dur,type,vol,delay=0){if(!audio||muted)return;try{const t=audio.currentTime+delay,o=audio.createOscillator(),g=audio.createGain();o.type=type;o.frequency.setValueAtTime(f,t);o.frequency.exponentialRampToValueAtTime(Math.max(15,end),t+dur);g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.001,t+dur);o.connect(g);g.connect(master);o.start(t);o.stop(t+dur+.02);}catch(e){}}\nfunction hiss(dur,f,vol){if(!audio||muted)return;try{let t=audio.currentTime,s=audio.createBufferSource(),filter=audio.createBiquadFilter(),g=audio.createGain();s.buffer=noise;filter.type='bandpass';filter.frequency.value=f;filter.Q.value=.7;g.gain.setValueAtTime(vol,t);g.gain.exponentialRampToValueAtTime(.001,t+dur);s.connect(filter);filter.connect(g);g.connect(master);s.start(t);s.stop(t+dur);}catch(e){}}\nfunction sfx(kind,power=1){\n if(kind==='swing'){hiss(.12,1500+power*300,.33);tone(220,70,.1,'triangle',.18)}\n if(kind==='hit'){hiss(.09,1900,.5);tone(150+power*25,40,.12+power*.025,'triangle',.7);tone(640,160,.055,'square',.09)}\n if(kind==='break'){hiss(.23,3200,.7);tone(110,26,.25,'sawtooth',.34);tone(900,220,.12,'square',.12,.025)}\n if(kind==='dash'){hiss(.18,650,.48);tone(340,90,.14,'sine',.2)}\n if(kind==='jump'){hiss(.09,900,.17);tone(160,340,.1,'triangle',.16)}\n if(kind==='hurt'){hiss(.16,450,.6);tone(100,32,.25,'sawtooth',.3)}\n if(kind==='shot'){tone(440,100,.12,'sawtooth',.22);hiss(.06,2200,.25)}\n if(kind==='perfect'){tone(700,1000,.17,'sine',.34);tone(1050,1600,.2,'sine',.23,.05)}\n if(kind==='charge'){tone(260,520,.16,'triangle',.13)}\n if(kind==='wave'){tone(330,330,.18,'sine',.2);tone(495,495,.28,'sine',.18,.13)}\n}\nsoundButton.onclick=()=>{unlock();muted=!muted;if(master)master.gain.value=muted?0:.24;soundButton.textContent='声音 '+(muted?'OFF':'ON');soundButton.blur()};\nlet keys=new Set(),input={j:0,k:0,i:0,l:0,jump:0},playing=false,paused=false;\nlet player,enemies=[],particles=[],pieces=[],rings=[],texts=[],ghosts=[],shots=[],spawnMarks=[];\nlet nextId=1,hitCount=0,limbBreakCount=0,kills=0,wave=1,chain=0,chainTimer=0,best=0;\nlet time=0,clock=0,stop=0,shake=0,cam=0,waveTimer=0,waveBanner=0,spawnTimer=0,toSpawn=0;\nconst codes=new Set(['KeyA','KeyD','ArrowLeft','ArrowRight','Space','KeyJ','KeyK','KeyL','KeyI','KeyR','Enter','ArrowUp','ArrowDown']);\naddEventListener('keydown',e=>{\n if(codes.has(e.code))e.preventDefault();unlock();\n if(e.repeat)return;\n keys.add(e.code);\n if(e.code==='KeyR'){reset();begin();return}\n if(e.code==='Enter'){if(!playing){if(player.hp<=0)reset();begin()}return}\n if(!playing&&player.hp>0&&codes.has(e.code))begin();\n if(!playing)return;\n if(e.code==='KeyJ')input.j=.23;\n if(e.code==='KeyK')input.k=.25;\n if(e.code==='KeyI')input.i=.25;\n if(e.code==='KeyL')input.l=.18;\n if(e.code==='Space')input.jump=.16;\n});\naddEventListener('keyup',e=>{if(codes.has(e.code))e.preventDefault();keys.delete(e.code)});\nfunction clearInput(){keys.clear();for(const k in input)input[k]=0}\naddEventListener('blur',()=>{clearInput();paused=true;if(player)player.charging=false});\naddEventListener('focus',()=>{paused=false});\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden){clearInput();paused=true}else paused=false});\ndocument.getElementById('start').onclick=()=>{unlock();if(player.hp<=0)reset();begin();document.getElementById('start').blur()};\nfunction begin(){playing=true;paused=false;veil.style.display='none';waveBanner=2.5}\nfunction makeEnemy(x,type){\n return {id:nextId++,x,y:G,vx:0,vy:0,face:x>player.x?-1:1,type,hp:type==='gun'?88:78,maxHp:type==='gun'?88:78,\n arm:true,leg:true,armHP:48,legHP:56,state:'idle',t:0,cd:rand(.5,1.1),hurt:0,flash:0,walk:rand(0,6),aim:0,hasHit:false,spawn:.45};\n}\nfunction reset(){\n player={x:world*.44,y:G,vx:0,vy:0,face:1,hp:100,displayHP:100,invul:0,hurt:0,stun:0,ground:true,jumps:0,coyote:.1,\n attack:null,charging:false,charge:0,chargeLevel:0,combo:0,comboTimer:0,dash:0,dashCD:0,liftCD:0,empower:0,ghostTimer:0,walk:0};\n enemies=[];particles=[];pieces=[];rings=[];texts=[];ghosts=[];shots=[];spawnMarks=[];\n nextId=1;hitCount=0;limbBreakCount=0;kills=0;wave=1;chain=0;chainTimer=0;best=0;stop=0;shake=0;time=0;waveTimer=0;waveBanner=2.6;toSpawn=1;spawnTimer=2;\n cam=clamp(player.x-W*.45,0,Math.max(0,world-W));\n enemies.push(makeEnemy(player.x+270,'blade'),makeEnemy(player.x-330,'blade'),makeEnemy(player.x+540,'gun'));\n clearInput();\n}\nreset();\nwindow.combatBenchState=()=>({ready:true,playerAlive:player.hp>0,enemyCount:enemies.filter(e=>e.hp>0).length,hitCount,limbBreakCount,playing,paused,wave,playerHP:Math.ceil(player.hp)});\nconst specs=[\n {name:'cut',wind:.065,active:.115,recover:.14,damage:18,range:123,knock:105,freeze:.045,a:-2.1,b:1.05,power:1},\n {name:'cross',wind:.065,active:.12,recover:.16,damage:21,range:132,knock:130,freeze:.055,a:1.4,b:-1.7,power:1},\n {name:'finish',wind:.115,active:.145,recover:.22,damage:29,range:153,knock:260,freeze:.085,a:-2.65,b:1.0,power:2}\n];\nfunction startAttack(kind,level=0){\n const p=player;let s;\n if(kind==='j'){if(p.comboTimer<=0)p.combo=0;s={...specs[p.combo]};p.combo=(p.combo+1)%3;p.comboTimer=.8}\n else if(kind==='heavy'){s={name:'heavy',wind:level===2?.07:.135,active:.17,recover:.25,damage:level===2?65:level===1?47:33,range:level===2?181:155,knock:level===2?490:330,freeze:level===2?.135:.095,a:-2.45,b:1.25,power:level===2?4:3,level};p.combo=0}\n else{s={name:'lift',wind:.09,active:.16,recover:.21,damage:23,range:131,knock:80,freeze:.07,a:1.65,b:-1.8,power:2};p.liftCD=1.65;p.combo=0}\n p.attack={...s,age:0,total:s.wind+s.active+s.recover,hit:new Set(),fired:false};p.charging=false;\n}\nfunction emit(x,y,n,color,force=1,dir=0){\n for(let i=0;i<n;i++){let a=rand(-Math.PI,Math.PI),v=rand(75,300)*force;\n particles.push({x,y,vx:Math.cos(a)*v+dir*100,vy:Math.sin(a)*v-40,life:rand(.15,.46),max:.46,color,size:rand(1,3),gravity:430});}\n if(particles.length>550)particles.splice(0,particles.length-550);\n}\nfunction ring(x,y,color,r=40,life=.25){rings.push({x,y,color,r,life,max:life})}\nfunction label(x,y,text,color='#eee5bc',size=15){texts.push({x,y,text,color,size,life:1,max:1})}\nfunction dust(x,y,force=1){emit(x,y-2,7,'#6c9898',force);ring(x,y,'#709b9c',25*force,.25)}\nfunction impact(x,y,power,face){\n emit(x,y,power>2?23:12,power>2?'#ffd8a2':'#c5fff0',power>2?1.3:.8,face);\n emit(x,y,6,'#ff8465',1,face);ring(x,y,power>2?'#ffc49a':'#c6fff0',power>2?62:35,.18);\n shake=Math.max(shake,power>2?7:power===2?4.5:2.8);\n}\nfunction segment(a,b,w,color,edge='#10252d'){\n ctx.lineCap='round';ctx.lineJoin='round';ctx.strokeStyle=edge;ctx.lineWidth=w+3;ctx.beginPath();ctx.moveTo(a[0],a[1]);ctx.lineTo(b[0],b[1]);ctx.stroke();\n ctx.strokeStyle=color;ctx.lineWidth=w;ctx.stroke();\n ctx.strokeStyle='rgba(235,255,247,.24)';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(a[0]-2,a[1]-2);ctx.lineTo(b[0]-2,b[1]-2);ctx.stroke();\n}\nfunction poly(points,fill,stroke){\n ctx.beginPath();ctx.moveTo(points[0][0],points[0][1]);for(let i=1;i<points.length;i++)ctx.lineTo(points[i][0],points[i][1]);ctx.closePath();ctx.fillStyle=fill;ctx.fill();if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=1;ctx.stroke()}\n}\nfunction enemyPose(e){\n const crawl=e.leg?0:24,air=e.y<G-3,walk=Math.sin(e.walk),h=-48+crawl,s=[3,h-19];\n let angle=-.25;\n if(e.type==='gun'&&e.arm){angle=e.state==='wind'||e.state==='active'?Math.atan2(Math.sin(e.aim),Math.abs(Math.cos(e.aim))):-.12}\n else if(e.state==='wind'){angle=-2.2-Math.sin(e.t*7)*.08}\n else if(e.state==='active'){angle=lerp(-2.2,1.1,clamp(e.t/.16,0,1))}\n else if(e.state==='recover')angle=1.1;\n if(e.hurt>0)angle=-2.5;\n let hand=[s[0]+Math.cos(angle)*30,s[1]+Math.sin(angle)*30],elbow=[s[0]+Math.cos(angle+.65)*18,s[1]+Math.sin(angle+.65)*18];\n return {crawl,h,s,angle,hand,elbow,head:[-3+(e.hurt>0?-8:0),h-37],\n  la:[[ -7,h+4],[-12-walk*9,air?-22:-22],[air?-22:-16-walk*17,air?-8:0]],\n  lb:[[7,h+5],[14+walk*9,-20],[air?20:15+walk*17,air?-13:0]],\n  back:[[-12,h-16],[-22,h+2],[-14,h+13]]};\n}\nfunction makePiece(x,y,w,h,color,vx,vy,angle=0,kind='plate'){\n pieces.push({x,y,w,h,color,vx,vy,a:angle,spin:rand(-9,9),life:rand(3.8,5.8),max:5.8,kind,bounces:0});\n if(pieces.length>180)pieces.shift();\n}\nfunction detachSegment(e,a,b,w,color){\n const dx=(b[0]-a[0])*e.face,dy=b[1]-a[1];\n makePiece(e.x+(a[0]+b[0])*.5*e.face,e.y+(a[1]+b[1])*.5,Math.hypot(dx,dy)+5,w,color,\n e.vx*.35+rand(-160,160),rand(-410,-220),Math.atan2(dy,dx));\n}\nfunction breakLimb(e,which){\n if(!e[which])return;\n let q=enemyPose(e),color=e.type==='gun'?'#bd9369':'#9caead';\n if(which==='arm'){\n detachSegment(e,q.s,q.elbow,11,color);detachSegment(e,q.elbow,q.hand,13,color);\n let wx=e.x+(q.hand[0]+Math.cos(q.angle)*27)*e.face,wy=e.y+q.hand[1]+Math.sin(q.angle)*27;\n makePiece(wx,wy,e.type==='gun'?42:66,e.type==='gun'?15:6,e.type==='gun'?'#726b5a':'#c1d7ce',rand(-150,180),rand(-400,-260),q.angle*e.face);\n }else{\n detachSegment(e,q.lb[0],q.lb[1],15,color);detachSegment(e,q.lb[1],q.lb[2],12,color);\n makePiece(e.x+q.lb[2][0]*e.face,e.y+q.lb[2][1],20,8,'#758b8a',rand(-200,200),-260);\n }\n e[which]=false;limbBreakCount++;e.hurt=Math.max(e.hurt,.32);\n const y=e.y+(which==='arm'?q.h-18:q.h+6);\n emit(e.x,y,18,'#ffc58b',1.3);ring(e.x,y,'#ff9b70',60,.3);\n label(e.x,e.y-115,which==='arm'?(e.type==='gun'?'断臂 / 火力解除':'断臂 / 刀刃脱落'):'断腿 / 机动失能','#ffbc8c',13);\n stop=Math.max(stop,.10);sfx('break');\n}\nfunction killEnemy(e){\n if(e.hp===-999)return;\n e.hp=-999;kills++;player.hp=Math.min(100,player.hp+2);\n const q=enemyPose(e),col=e.type==='gun'?'#ad8c68':'#819997';\n if(e.arm){detachSegment(e,q.s,q.elbow,11,col);detachSegment(e,q.elbow,q.hand,12,col)}\n detachSegment(e,q.back[0],q.back[1],9,col);\n if(e.leg){detachSegment(e,q.lb[0],q.lb[1],14,col);detachSegment(e,q.lb[1],q.lb[2],11,col)}\n detachSegment(e,q.la[0],q.la[1],12,col);detachSegment(e,q.la[1],q.la[2],10,col);\n makePiece(e.x,e.y+q.h-10,31,32,col,e.vx*.5,rand(-300,-180),rand(-.5,.5));\n makePiece(e.x+q.head[0]*e.face,e.y+q.head[1],23,21,'#bac4b7',rand(-150,150),-330,0,'head');\n emit(e.x,e.y-45,20,'#fcb181',1.1);ring(e.x,e.y-45,'#83cab9',55,.3);\n}\nfunction hitEnemy(e,a,face=player.face,reflect=false){\n if(e.hp<=0)return;\n hitCount++;chain++;best=Math.max(best,chain);chainTimer=2.5;\n e.hp-=a.damage;e.flash=.12;e.hurt=a.power>2?.34:.20;e.state='idle';e.t=0;e.cd=.48;\n e.vx=face*a.knock;\n if(a.name==='lift')e.vy=-620;\n else if(e.y<G-5)e.vy=Math.min(e.vy,-170);\n else if(a.power>=2)e.vy=a.power>2?-240:-175;\n const hx=e.x-face*15,hy=e.y-(e.leg?48:27);\n impact(hx,hy,a.power,face);stop=Math.max(stop,a.freeze);sfx('hit',a.power);\n if(!reflect){\n  if(a.name==='heavy'){if(e.leg){e.legHP-=a.level===2?110:a.level===1?75:36;if(e.legHP<=0)breakLimb(e,'leg')}\n  else if(e.arm){e.armHP-=a.level===2?100:52;if(e.armHP<=0)breakLimb(e,'arm')}}\n  else {e.armHP-=a.name==='finish'?38:a.name==='lift'?15:10;if(e.arm&&e.armHP<=0)breakLimb(e,'arm')}\n }\n if(e.hp<=0)killEnemy(e);\n}\nfunction perfectDodge(){\n if(player.empower>1.8)return;\n player.empower=2.6;label(player.x,player.y-112,'擦身 · 断势','#91ffe0',18);\n ring(player.x,player.y-45,'#a4ffe6',85,.3);sfx('perfect');\n}\nfunction hurtPlayer(dmg,x){\n const p=player;\n if(p.dash>0){perfectDodge();return}\n if(p.invul>0||p.hp<=0)return;\n p.hp=Math.max(0,p.hp-dmg);p.invul=.95;p.hurt=.25;p.stun=.17;p.attack=null;p.charging=false;p.vx=(p.x<x?-1:1)*260;p.vy=-150;\n chain=0;chainTimer=0;shake=7;stop=.09;impact(p.x,p.y-45,2,p.x<x?-1:1);sfx('hurt');\n if(p.hp<=0){playing=false;veil.style.display='flex';document.getElementById('title').textContent='潮 息';\n document.getElementById('subtitle').textContent='SYSTEM OFFLINE / 第 '+wave+' 波';\n document.getElementById('desc').innerHTML='已击破 <b>'+kills+'</b> 台构装