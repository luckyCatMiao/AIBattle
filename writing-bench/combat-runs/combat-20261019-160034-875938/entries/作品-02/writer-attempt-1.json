  "text": "<!DOCTYPE html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0,user-scalable=no\">\n<title>BLADE BREAKER - 横版动作战斗试玩</title>\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; user-select: none; }\n  body, html {\n    width: 100%; height: 100%; overflow: hidden;\n    background: #0a0b10; font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"PingFang SC\", sans-serif;\n    color: #e0e6ed;\n  }\n  #wrapper {\n    position: relative; width: 100vw; height: 100vh;\n    display: flex; align-items: center; justify-content: center;\n    background: radial-gradient(circle at center, #161a29 0%, #08090f 100%);\n  }\n  canvas {\n    display: block; width: 100%; height: 100%;\n    image-rendering: -webkit-optimize-contrast;\n  }\n  #ui-layer {\n    position: absolute; top: 0; left: 0; width: 100%; height: 100%;\n    pointer-events: none; padding: 18px 24px;\n    display: flex; flex-direction: column; justify-content: space-between;\n  }\n  .hud-top {\n    display: flex; justify-content: space-between; align-items: flex-start;\n  }\n  .player-status {\n    width: 320px;\n  }\n  .bar-container {\n    height: 14px; background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(255,255,255,0.2);\n    border-radius: 3px; overflow: hidden; position: relative; margin-bottom: 6px;\n    box-shadow: 0 0 10px rgba(0,0,0,0.5);\n  }\n  .bar-hp {\n    width: 100%; height: 100%; background: linear-gradient(90deg, #ff2a5f, #ff725c);\n    transition: width 0.08s ease-out;\n  }\n  .bar-stamina {\n    height: 6px; background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(255,255,255,0.15);\n    border-radius: 2px; overflow: hidden;\n  }\n  .bar-sp {\n    width: 100%; height: 100%; background: linear-gradient(90deg, #00d2ff, #00fff2);\n    transition: width 0.05s ease-out;\n  }\n  .hud-stats {\n    font-size: 13px; color: #8ba0b8; letter-spacing: 0.5px;\n    display: flex; gap: 14px; text-shadow: 0 1px 2px rgba(0,0,0,0.8);\n  }\n  .hud-stats span { color: #fff; font-weight: bold; }\n  .controls-guide {\n    background: rgba(10, 14, 22, 0.75); border: 1px solid rgba(255, 255, 255, 0.12);\n    padding: 10px 14px; border-radius: 6px; backdrop-filter: blur(4px);\n    display: flex; gap: 16px; font-size: 12px; color: #b4c2d4;\n  }\n  .key-badge {\n    background: #2a3346; color: #fff; padding: 2px 6px; border-radius: 3px;\n    font-family: monospace; font-size: 11px; border-bottom: 2px solid #171d28;\n    margin-right: 4px; display: inline-block;\n  }\n  .btn-panel {\n    pointer-events: auto; display: flex; gap: 10px; align-items: center;\n  }\n  .hud-btn {\n    background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.2);\n    color: #fff; font-size: 12px; padding: 6px 14px; border-radius: 4px;\n    cursor: pointer; transition: all 0.15s; outline: none;\n  }\n  .hud-btn:hover { background: rgba(255,255,255,0.2); border-color: #fff; }\n  #msg-overlay {\n    position: absolute; top: 38%; left: 50%; transform: translate(-50%, -50%);\n    text-align: center; pointer-events: auto; display: none;\n  }\n  #msg-overlay h1 {\n    font-size: 42px; font-weight: 900; letter-spacing: 4px;\n    text-transform: uppercase; margin-bottom: 12px;\n    text-shadow: 0 0 20px rgba(255,40,90,0.8);\n  }\n  #msg-overlay p { font-size: 15px; color: #ccd6e0; margin-bottom: 20px; }\n</style>\n</head>\n<body>\n<div id=\"wrapper\">\n  <canvas id=\"cvs\" width=\"1280\" height=\"720\"></canvas>\n  <div id=\"ui-layer\">\n    <div class=\"hud-top\">\n      <div class=\"player-status\">\n        <div class=\"bar-container\"><div id=\"bar-hp\" class=\"bar-hp\"></div></div>\n        <div class=\"bar-stamina\"><div id=\"bar-sp\" class=\"bar-sp\"></div></div>\n        <div class=\"hud-stats\" style=\"margin-top:6px;\">\n          <div>连击: <span id=\"txt-combo\" style=\"color:#ffb347;\">0</span></div>\n          <div>命中: <span id=\"txt-hits\">0</span></div>\n          <div>破坏肢体: <span id=\"txt-breaks\" style=\"color:#00e5ff;\">0</span></div>\n          <div>波次: <span id=\"txt-wave\">1</span></div>\n        </div>\n      </div>\n      <div class=\"btn-panel\">\n        <button id=\"btn-sound\" class=\"hud-btn\">音效: 开</button>\n        <button id=\"btn-restart\" class=\"hud-btn\">重置战斗 [R]</button>\n      </div>\n    </div>\n    <div class=\"controls-guide\">\n      <div><span class=\"key-badge\">A</span><span class=\"key-badge\">D</span> 移动</div>\n      <div><span class=\"key-badge\">Space</span> 跳跃</div>\n      <div><span class=\"key-badge\">J</span> 迅光连斩 (主攻/空中下劈)</div>\n      <div><span class=\"key-badge\">K</span> 崩山重斩 (长按蓄力·破甲断肢)</div>\n      <div><span class=\"key-badge\">L</span> 残影滑冲 (无敌帧)</div>\n      <div><span class=\"key-badge\">I</span> 升龙升空 (破防挑空追击)</div>\n      <div><span class=\"key-badge\">R</span> 重启</div>\n    </div>\n  </div>\n  <div id=\"msg-overlay\">\n    <h1 id=\"msg-title\" style=\"color:#ff3355;\">战体崩溃</h1>\n    <p id=\"msg-desc\">按 [R] 键或点击下方按钮重整态势</p>\n    <button class=\"hud-btn\" id=\"btn-modal-action\" style=\"padding:10px 24px;font-size:14px;background:#ff2a5f;border:none;\">立刻再战</button>\n  </div>\n</div>\n\n<script>\n// ==================== 音频合成引擎 (Web Audio API) ====================\nlet audioCtx = null;\nlet soundEnabled = true;\n\nfunction initAudio() {\n  if (!audioCtx) {\n    const AudioContext = window.AudioContext || window.webkitAudioContext;\n    if (AudioContext) audioCtx = new AudioContext();\n  }\n  if (audioCtx && audioCtx.state === 'suspended') {\n    audioCtx.resume();\n  }\n}\n\nfunction playSound(type) {\n  if (!soundEnabled || !audioCtx) return;\n  try {\n    const t = audioCtx.currentTime;\n    const osc = audioCtx.createOscillator();\n    const gain = audioCtx.createGain();\n    osc.connect(gain);\n    gain.connect(audioCtx.destination);\n\n    if (type === 'slash_light') {\n      osc.type = 'triangle';\n      osc.frequency.setValueAtTime(480, t);\n      osc.frequency.exponentialRampToValueAtTime(140, t + 0.08);\n      gain.gain.setValueAtTime(0.2, t);\n      gain.gain.linearRampToValueAtTime(0.01, t + 0.08);\n      osc.start(t); osc.stop(t + 0.08);\n    } else if (type === 'slash_heavy') {\n      osc.type = 'sawtooth';\n      osc.frequency.setValueAtTime(320, t);\n      osc.frequency.exponentialRampToValueAtTime(60, t + 0.18);\n      gain.gain.setValueAtTime(0.35, t);\n      gain.gain.linearRampToValueAtTime(0.01, t + 0.18);\n      osc.start(t); osc.stop(t + 0.18);\n    } else if (type === 'hit_light') {\n      osc.type = 'square';\n      osc.frequency.setValueAtTime(180, t);\n      osc.frequency.exponentialRampToValueAtTime(50, t + 0.09);\n      gain.gain.setValueAtTime(0.3, t);\n      gain.gain.linearRampToValueAtTime(0.01, t + 0.09);\n      osc.start(t); osc.stop(t + 0.09);\n    } else if (type === 'hit_heavy') {\n      // 爆炸轰鸣\n      const bufferSize = audioCtx.sampleRate * 0.2;\n      const buffer = audioCtx.createBuffer(1, bufferSize, audioCtx.sampleRate);\n      const data = buffer.getChannelData(0);\n      for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;\n      const noise = audioCtx.createBufferSource();\n      noise.buffer = buffer;\n      const filter = audioCtx.createBiquadFilter();\n      filter.type = 'lowpass';\n      filter.frequency.setValueAtTime(350, t);\n      filter.frequency.linearRampToValueAtTime(70, t + 0.2);\n      gain.gain.setValueAtTime(0.6, t);\n      gain.gain.linearRampToValueAtTime(0.01, t + 0.2);\n      noise.connect(filter);\n      filter.connect(gain);\n      noise.start(t); noise.stop(t + 0.2);\n    } else if (type === 'dash') {\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(260, t);\n      osc.frequency.exponentialRampToValueAtTime(700, t + 0.14);\n      gain.gain.setValueAtTime(0.2, t);\n      gain.gain.linearRampToValueAtTime(0.01, t + 0.14);\n      osc.start(t); osc.stop(t + 0.14);\n    } else if (type === 'break') {\n      // 机械撕裂金属碎裂声\n      osc.type = 'sawtooth';\n      osc.frequency.setValueAtTime(800, t);\n      osc.frequency.exponentialRampToValueAtTime(90, t + 0.25);\n      gain.gain.setValueAtTime(0.5, t);\n      gain.gain.linearRampToValueAtTime(0.01, t + 0.25);\n      osc.start(t); osc.stop(t + 0.25);\n    } else if (type === 'uppercut') {\n      osc.type = 'sine';\n      osc.frequency.setValueAtTime(220, t);\n      osc.frequency.exponentialRampToValueAtTime(650, t + 0.18);\n      gain.gain.setValueAtTime(0.3, t);\n      gain.gain.linearRampToValueAtTime(0.01, t + 0.18);\n      osc.start(t); osc.stop(t + 0.18);\n    }\n  } catch(e) {}\n}\n\n// ==================== 游戏全局与状态 ====================\nconst cvs = document.getElementById('cvs');\nconst ctx = cvs.getContext('2d');\nconst W = 1280;\nconst H = 720;\nconst FLOOR_Y = 580;\n\nlet hitStopTimer = 0;\nlet shakeTimer = 0;\nlet shakeIntensity = 0;\nlet totalHits = 0;\nlet totalBreaks = 0;\nlet currentWave = 1;\nlet isGameOver = false;\n\n// 按键监听\nconst keys = {};\nconst keyMap = {\n  KeyA: 'left', ArrowLeft: 'left',\n  KeyD: 'right', ArrowRight: 'right',\n  Space: 'jump',\n  KeyJ: 'atk',\n  KeyK: 'heavy',\n  KeyL: 'dash',\n  KeyI: 'uppercut',\n  KeyR: 'restart',\n  Enter: 'confirm'\n};\n\nwindow.addEventListener('keydown', (e) => {\n  initAudio();\n  if (['Space','ArrowLeft','ArrowRight','ArrowUp','ArrowDown','KeyJ','KeyK','KeyL','KeyI','KeyR'].includes(e.code)) {\n    e.preventDefault();\n  }\n  const action = keyMap[e.code];\n  if (action) keys[action] = true;\n  if (action === 'restart') resetGame();\n});\n\nwindow.addEventListener('keyup', (e) => {\n  const action = keyMap[e.code];\n  if (action) keys[action] = false;\n});\n\nwindow.addEventListener('blur', () => {\n  for (let k in keys) keys[k] = false;\n});\n\ndocument.getElementById('btn-sound').onclick = (e) => {\n  initAudio();\n  soundEnabled = !soundEnabled;\n  e.target.innerText = `音效: ${soundEnabled ? '开' : '关'}`;\n};\ndocument.getElementById('btn-restart').onclick = () => resetGame();\ndocument.getElementById('btn-modal-action').onclick = () => resetGame();\n\n// 辅助检测接口\nwindow.combatBenchState = function() {\n  return {\n    ready: true,\n    playerAlive: player.hp > 0,\n    enemyCount: enemies.length,\n    hitCount: totalHits,\n    limbBreakCount: totalBreaks,\n    playing: !isGameOver\n  };\n};\n\n// ==================== 粒子与特效系统 ====================\nconst particles = [];\nconst slashFxList = [];\nconst flyingLimbs = [];\n\nfunction addSlash(x, y, radius, startAngle, endAngle, facing, color, width=4) {\n  slashFxList.push({\n    x, y, radius, startAngle, endAngle, facing,\n    color, width, life: 1, maxLife: 7\n  });\n}\n\nfunction addSpark(x, y, color='#ffea78', count=8, speed=6) {\n  for (let i = 0; i < count; i++) {\n    const ang = Math.random() * Math.PI * 2;\n    const spd = (0.3 + Math.random() * 0.7) * speed;\n    particles.push({\n      x, y,\n      vx: Math.cos(ang) * spd,\n      vy: Math.sin(ang) * spd - 1,\n      color,\n      size: 2 + Math.random() * 3,\n      life: 1,\n      maxLife: 10 + Math.random() * 10\n    });\n  }\n}\n\nfunction triggerShake(frames, intensity) {\n  shakeTimer = Math.max(shakeTimer, frames);\n  shakeIntensity = intensity;\n}\n\nfunction triggerHitStop(frames) {\n  hitStopTimer = Math.max(hitStopTimer, frames);\n}\n\n// ==================== 玩家设计 ====================\nclass Player {\n  constructor() {\n    this.reset();\n  }\n\n  reset() {\n    this.x = 260;\n    this.y = FLOOR_Y;\n    this.vx = 0;\n    this.vy = 0;\n    this.facing = 1;\n    this.width = 36;\n    this.height = 72;\n    this.hp = 100;\n    this.maxHp = 100;\n    this.stamina = 100;\n    this.maxStamina = 100;\n    this.isGrounded = true;\n    this.state = 'idle'; // idle, run, jump, atk, heavy_charge, heavy_release, uppercut, dash, hurt\n    this.stateTime = 0;\n    this.comboStep = 0;\n    this.comboTimer = 0;\n    this.dashTimer = 0;\n    this.dashCd = 0;\n    this.heavyCharge = 0;\n    this.invulnerableTimer = 0;\n    this.hitRegistered = false;\n    this.currentComboCount = 0;\n    this.comboWindowTimer = 0;\n  }\n\n  update() {\n    // 恢复与CD\n    if (this.dashCd > 0) this.dashCd--;\n    if (this.invulnerableTimer > 0) this.invulnerableTimer--;\n    if (this.comboTimer > 0) {\n      this.comboTimer--;\n      if (this.comboTimer === 0) this.comboStep = 0;\n    }\n    if (this.comboWindowTimer > 0) {\n      this.comboWindowTimer--;\n      if (this.comboWindowTimer === 0) this.currentComboCount = 0;\n    }\n\n    if (this.stamina < this.maxStamina) this.stamina += 0.8;\n\n    this.stateTime++;\n\n    // 状态机处理\n    switch(this.state) {\n      case 'idle':\n      case 'run':\n        this.handleMovement();\n        this.handleAttacks();\n        break;\n      case 'jump':\n        this.handleAirMovement();\n        this.handleAttacks();\n        break;\n      case 'atk':\n        this.updateLightAttack();\n        break;\n      case 'heavy_charge':\n        this.updateHeavyCharge();\n        break;\n      case 'heavy_release':\n        this.updateHeavyRelease();\n        break;\n      case 'uppercut':\n        this.updateUppercut();\n        break;\n      case 'dash':\n        this.updateDash();\n        break;\n      case 'hurt':\n        if (this.stateTime > 14) this.state = 'idle';\n        break;\n    }\n\n    // 物理积分\n    this.x += this.vx;\n    this.y += this.vy;\n\n    // 重力\n    if (this.y < FLOOR_Y) {\n      this.vy += 0.95;\n      this.isGrounded = false;\n    } else {\n      this.y = FLOOR_Y;\n      this.vy = 0;\n      this.isGrounded = true;\n      if (this.state === 'jump') this.state = 'idle';\n    }\n\n    // 场地边缘限制\n    if (this.x < 60) { this.x = 60; this.vx = 0; }\n    if (this.x > W - 60) { this.x = W - 60; this.vx = 0; }\n  }\n\n  handleMovement() {\n    const moveLeft = keys.left;\n    const moveRight = keys.right;\n    const spd = 6.8;\n\n    if (moveLeft && !moveRight) {\n      this.vx = -spd;\n      this.facing = -1;\n      this.state = 'run';\n    } else if (moveRight && !moveLeft) {\n      this.vx = spd;\n      this.facing = 1;\n      this.state = 'run';\n    } else {\n      this.vx = 0;\n      this.state = 'idle';\n    }\n\n    if (keys.jump && this.isGrounded) {\n      this.vy = -16.5;\n      this.isGrounded = false;\n      this.state = 'jump';\n      addSpark(this.x, this.y, '#ffffff', 5, 3);\n    }\n  }\n\n  handleAirMovement() {\n    const spd = 5.2;\n    if (keys.left) { this.vx = -spd; this.facing = -1; }\n    else if (keys.right) { this.vx = spd; this.facing = 1; }\n    else { this.vx *= 0.92; }\n  }\n\n  handleAttacks() {\n    // 冲刺\n    if (keys.dash && this.dashCd <= 0 && this.stamina >= 20) {\n      this.stamina -= 20;\n      this.dashCd = 26;\n      this.dashTimer = 14;\n      this.state = 'dash';\n      this.stateTime = 0;\n      this.invulnerableTimer = 16;\n      this.vx = this.facing * 16;\n      this.vy = 0;\n      playSound('dash');\n      return;\n    }\n\n    // 挑空升龙 (I)\n    if (keys.uppercut) {\n      keys.uppercut = false;\n      this.state = 'uppercut';\n      this.stateTime = 0;\n      this.hitRegistered = false;\n      this.vy = -14;\n      this.vx = this.facing * 4;\n      playSound('uppercut');\n      return;\n    }\n\n    // 重击蓄力 (K)\n    if (keys.heavy) {\n      this.state = 'heavy_charge';\n      this.stateTime = 0;\n      this.heavyCharge = 0;\n      this.vx = 0;\n      return;\n    }\n\n    // 轻击三连 / 空中下劈 (J)\n    if (keys.atk) {\n      keys.atk = false;\n      this.state = 'atk';\n      this.stateTime = 0;\n      this.hitRegistered = false;\n      if (!this.isGrounded) {\n        // 空中下劈\n        this.comboStep = 9; // 特殊标记\n        this.vy = 8;\n        this.vx = this.facing * 5;\n      } else {\n        this.comboStep = (this.comboStep % 3) + 1;\n        this.vx = this.facing * (this.comboStep === 3 ? 9 : 4);\n      }\n      playSound('slash_light');\n      this.comboTimer = 35;\n    }\n  }\n\n  updateLightAttack() {\n    // 动作帧控制: 1-4 前摇, 5-9 判定帧, 10-18 收招\n    this.vx *= 0.85;\n\n    if (this.comboStep === 9) { // 空中向下俯冲劈砍\n      this.vy += 0.8;\n      if (this.stateTime === 2) {\n        addSlash(this.x, this.y - 30, 48, -Math.PI*0.3, Math.PI*0.6, this.facing, '#4deeea', 5);\n      }\n      if (!this.hitRegistered && this.stateTime >= 2 && this.stateTime <= 10) {\n        this.checkHitBox(60, 50, 14, 4, 3, 6);\n      }\n      if (this.isGrounded || this.stateTime > 18) {\n        if (this.isGrounded) triggerShake(5, 3);\n        this.state = 'idle';\n      }\n      return;\n    }\n\n    // 地面普攻 1/2/3 段\n    if (this.stateTime === 4) {\n      const radius = this.comboStep === 3 ? 65 : 52;\n      const arc = this.comboStep === 1 ? [-0.6, 0.6] : (this.comboStep === 2 ? [0.6, -0.6] : [-0.9, 0.9]);\n      addSlash(this.x + this.facing * 18, this.y - 36, radius, arc[0], arc[1], this.facing, this.comboStep === 3 ? '#ff9a3c' : '#ffffff', 4);\n    }\n\n    if (!this.hitRegistered && this.stateTime >= 4 && this.stateTime <= 8) {\n      const dmg = this.comboStep === 3 ? 24 : 14;\n      const knockX = this.comboStep === 3 ? 12 : 5;\n      const knockY = this.comboStep === 3 ? -5 : -1.5;\n      const hitStop = this.comboStep === 3 ? 8 : 4;\n      this.checkHitBox(this.comboStep === 3 ? 75 : 55, 40, dmg, knockX, knockY, hitStop, this.comboStep === 3);\n    }\n\n    const animEnd = this.comboStep === 3 ? 20 : 13;\n    if (this.stateTime > animEnd) {\n      this.state = 'idle';\n    }\n  }\n\n  updateHeavyCharge() {\n    this.heavyCharge++;\n    this.vx = 0;\n    if (this.heavyCharge % 6 === 0) {\n      addSpark(this.x + (Math.random()-0.5)*20, this.y - 35, '#ff3864', 3, 3);\n    }\n    // 松开K或达到最大蓄力自动释放\n    if (!keys.heavy || this.heavyCharge >= 40) {\n      this.state = 'heavy_release';\n      this.stateTime = 0;\n      this.hitRegistered = false;\n      this.vx = this.facing * (this.heavyCharge >= 30 ? 12 : 7);\n      playSound('slash_heavy');\n    }\n  }\n\n  updateHeavyRelease() {\n    this.vx *= 0.88;\n    const isFull = this.heavyCharge >= 30;\n\n    if (this.stateTime === 3) {\n      addSlash(this.x + this.facing * 25, this.y - 38, isFull ? 85 : 65, -1.2, 1.2, this.facing, isFull ? '#ff2a5f' : '#ff9438', 7);\n      triggerShake(isFull ? 10 : 5, isFull ? 6 : 3);\n    }\n\n    if (!this.hitRegistered && this.stateTime >= 3 && this.stateTime <= 9) {\n      const dmg = isFull ? 45 : 25;\n      const knockX = isFull ? 18 : 10;\n      const knockY = isFull ? -7 : -3;\n      const hitStop = isFull ? 12 : 7;\n      // 重蓄力必破肢\n      this.checkHitBox(isFull ? 90 : 70, 50, dmg, knockX, knockY, hitStop, true, isFull);\n    }\n\n    if (this.stateTime > 22) {\n      this.state = 'idle';\n    }\n  }\n\n  updateUppercut() {\n    this.vx *= 0.9;\n    if (this.stateTime === 2) {\n      addSlash(this.x + this.facing * 15, this.y - 45, 65, 1.3, -1.3, this.facing, '#845ec2', 5);\n    }\n    if (!this.hitRegistered && this.stateTime >= 2 && this.stateTime <= 7) {\n      this.checkHitBox(60, 65, 18, 2, -14, 6, true, false, true);\n    }\n    if (this.stateTime > 18) {\n      this.state = 'jump';\n    }\n  }\n\n  updateDash() {\n    this.dashTimer--;\n    // 残影拖尾\n    if (this.dashTimer % 2 === 0) {\n      particles.push({\n        x: this.x, y: this.y,\n        vx: 0, vy: 0,\n        ghost: true,\n        facing: this.facing,\n        life: 1, maxLife: 8\n      });\n    }\n    if (this.dashTimer <= 0) {\n      this.vx = this.facing * 3;\n      this.state = 'idle';\n    }\n  }\n\n  checkHitBox(range, hRange, damage, knockX, knockY, stopFrames, isHeavy=false, forceLimbBreak=false, isUppercut=false) {\n    const atkCenter = this.x + this.facing * (range * 0.55);\n    let hitAny = false;\n\n    for (let e of enemies) {\n      if (e.isDead) continue;\n      // 距离判定\n      const dx = Math.abs(atkCenter - e.x);\n      const dy = Math.abs((this.y - 35) - (e.y - 35));\n      if (dx < range * 0.65 && dy < hRange) {\n        hitAny = true;\n        this.hitRegistered = true;\n        e.takeHit(damage, this.facing * knockX, knockY, isHeavy, forceLimbBreak, isUppercut);\n        totalHits++;\n        this.currentComboCount++;\n        this.comboWindowTimer = 90;\n      }\n    }\n\n    if (hitAny) {\n      triggerHitStop(stopFrames);\n      triggerShake(stopFrames + 2, isHeavy ? 5 : 2);\n      playSound(isHeavy ? 'hit_heavy' : 'hit_light');\n    }\n  }\n\n  takeDamage(amount, knockDir) {\n    if (this.invulnerableTimer > 0 || isGameOver) return;\n    this.hp -= amount;\n    this.invulnerableTimer = 35;\n    this.state = 'hurt';\n    this.stateTime = 0;\n    this.vx = knockDir * 8;\n    this.vy = -5;\n    triggerShake(8, 4);\n    triggerHitStop(5);\n    playSound('hit_light');\n    addSpark(this.x, this.y - 35, '#ff2a5f', 12, 5);\n\n    if (this.hp <= 0) {\n      this.hp = 0;\n      onPlayerDeath();\n    }\n  }\n\n  draw(c) {\n    c.save();\n    c.translate(this.x, this.y);\n    c.scale(this.facing, 1);\n\n    // 无敌受击闪烁\n    if (this.invulnerableTimer > 0 && Math.floor(Date.now() / 60) % 2 === 0) {\n      c.globalAlpha = 0.5;\n    }\n\n    // 绘制角色身体分段姿态\n    const isDashing = this.state === 'dash';\n    const isAttacking = ['atk','heavy_release','uppercut'].includes(this.state);\n\n    // 影子\n    c.fillStyle = 'rgba(0,0,0,0.35)';\n    c.beginPath();\n    c.ellipse(0, 0, 24, 7, 0, 0, Math.PI * 2);\n    c.fill();\n\n    // 躯干倾角根据速度和状态\n    const tilt = isDashing ? 0.35 : (this.state === 'run' ? 0.15 : 0);\n    c.rotate(tilt);\n\n    // 腿部\n    c.strokeStyle = '#2b3648';\n    c.lineWidth = 6;\n    c.lineCap = 'round';\n\n    const legCycle = (this.state === 'run') ? Math.sin(this.stateTime * 0.4) * 14 : 0;\n    // 后腿\n    c.beginPath();\n    c.moveTo(-4, -30);\n    c.lineTo(-8 - legCycle, -14);\n    c.lineTo(-8 - legCycle*1.2, 0);\n    c.stroke();\n    // 前腿\n    c.beginPath();\n    c.moveTo(6, -30);\n    c.lineTo(8 + legCycle, -14);\n    c.lineTo(8 + legCycle*1.2, 0);\n    c.stroke();\n\n    // 战袍风衣下摆\n    c.fillStyle = '#ff2a5f';\n    c.beginPath();\n    c.moveTo(-10, -38);\n    c.lineTo(8, -38);\n    c.lineTo(12 - (this.vx * 1.5), -12);\n    c.lineTo(-14 - (this.vx * 1.8), -12);\n    c.closePath();\n    c.fill();\n\n    // 躯干护甲\n    c.fillStyle = '#1c2333';\n    c.fillRect(-9, -52, 18, 22);\n    c.fillStyle = '#3a86ff'; // 能量核心\n    c.fillRect(-2, -45, 5, 8);\n\n    // 头部\n    c.fillStyle = '#e2e8f0';\n    c.beginPath();\n    c.arc(0, -60, 9, 0, Math.PI*2);\n    c.fill();\n    // 目镜高光\n    c.fillStyle = '#00f0ff';\n    c.fillRect(3, -62, 5, 3);\n\n    // 手臂与武士刀\n    c.strokeStyle = '#d0d7de';\n    c.lineWidth = 4;\n    c.beginPath();\n    if (this.state === 'heavy_charge') {\n      // 蓄力双手后拉姿态\n      c.moveTo(0, -46);\n      c.lineTo(-16, -42);\n      c.lineTo(-24, -30);\n      c.stroke();\n      // 发光巨剑\n      c.strokeStyle = this.heavyCharge >= 30 ? '#ff2a5f' : '#ff9900';\n      c.lineWidth = 6;\n      c.beginPath();\n      c.moveTo(-24, -30);\n      c.lineTo(-44, -58);\n      c.stroke();\n    } else if (isAttacking) {\n      // 挥砍前展\n      c.moveTo(0, -46);\n      c.lineTo(16, -48);\n      c.lineTo(34, -40);\n      c.stroke();\n      // 刀刃\n      c.strokeStyle = '#ffffff';\n      c.lineWidth = 5;\n      c.beginPath();\n      c.moveTo(34, -40);\n      c.lineTo(60, -32);\n      c.stroke();\n    } else {\n      // 常规站姿刀挎在侧边\n      c.moveTo(0, -46);\n      c.lineTo(8, -36);\n      c.lineTo(10, -22);\n      c.stroke();\n      // 剑身\n      c.strokeStyle = '#94a3b8';\n      c.lineWidth = 3;\n      c.beginPath();\n      c.moveTo(10, -26);\n      c.lineTo(-18, 2);\n      c.stroke();\n    }\n\n    c.restore();\n  }\n}\n\n// ==================== 敌人类与肢体破坏机制 ====================\n// 肢体定义：每个敌人拥有[头部, 左臂(武器), 右臂, 躯干, 腿部]\n// 当特定肢体被打断时，敌人的外形破碎飞溅，攻击模式也会改变（如失去武器臂则不能重挥）\n\nclass Enemy {\n  constructor(x, type='brawler') {\n    this.x = x;\n    this.y = FLOOR_Y;\n    this.vx = 0;\n    this.vy = 0;\n    this.type = type; // 'brawler'(双刃破坏者), 'juggernaut'(重锤机甲)\n    this.facing = x > player.x ? -1 : 1;\n    this.hp = type === 'brawler' ? 70 : 160;\n    this.maxHp = this.hp;\n    this.isDead = false;\n    this.state = 'chase'; // chase, telegraph, attack, hurt, down\n    this.stateTime = 0;\n    this.hurtTimer = 0;\n    this.atkCoolDown = 60 + Math.random() * 40;\n    \n    // 肢体完整度 (true=完好, false=已断裂)\n    this.limbs = {\n      head: true,\n      weaponArm: true,\n      shieldArm: true,\n      legs: true\n    };\n    this.poise = type === 'brawler' ? 30 : 70; // 韧性\n    this.maxPoise = this.poise;\n  }\n\n  update() {\n    this.stateTime++;\n    if (this.atkCoolDown > 0) this.atkCoolDown--;\n\n    // 韧性渐回\n    if (this.hurtTimer === 0 && this.poise < this.maxPoise) {\n      this.poise += 0.2;\n    }\n\n    const distToPlayer = player.x - this.x;\n    const absDist = Math.abs(distToPlayer);\n\n    // 状态行为\n    if (this.hurtTimer > 0) {\n      this.hurtTimer--;\n      this.vx *= 0.85;\n      if (this.hurtTimer === 0 && this.hp > 0) {\n        this.state = 'chase';\n      }\n    } else {\n      switch(this.state) {\n        case 'chase':\n          this.facing = distToPlayer > 0 ? 1 : -1;\n          const chaseSpd = this.limbs.legs ? (this.type === 'brawler' ? 3.4 : 1.8) : 0.9;\n          const attackRange = this.type === 'brawler' ? 65 : 95;\n\n          if (absDist > attackRange) {\n            this.vx = this.facing * chaseSpd;\n          } else {\n            this.vx = 0;\n            if (this.atkCoolDown <= 0) {\n              this.startAttackTelegraph();\n            }\n          }\n          break;\n\n        case 'telegraph': // 攻击前兆（警示红光/蓄势）\n          this.vx *= 0.5;\n          const preTime = this.type === 'brawler' ? 22 : 36;\n          if (this.stateTime >= preTime) {\n            this.executeAttack();\n          }\n          break;\n\n        case 'attack':\n          this.updateAttack();\n          break;\n      }\n    }\n\n    // 物理移动\n    this.x += this.vx;\n    this.y += this.vy;\n\n    // 重力\n    if (this.y < FLOOR_Y) {\n      this.vy += 0.9;\n    } else {\n      this.y = FLOOR_Y;\n      this.vy = 0;\n    }\n\n    // 边缘推离\n    if (this.x < 40) this.x = 40;\n    if (this.x > W - 40) this.x = W - 40;\n  }\n\n  startAttackTelegraph() {\n    this.state = 'telegraph';\n    this.stateTime = 0;\n    // 警示特效\n    addSpark(this.x, this.y - 55, '#ff0033', 4, 2);\n  }\n\n  executeAttack() {\n    this.state = 'attack';\n    this.stateTime = 0;\n    // 断臂则攻击减弱\n    const power = this.limbs.weaponArm ? 1 : 0.4;\n    this.vx = this.facing * (this.type === 'brawler' ? 7 * power : 5 * power);\n    playSound('slash_heavy');\n  }\n\n  updateAttack() {\n    const isHeavyMech = this.type === 'juggernaut';\n    const hitTime = isHeavyMech ? 8 : 6;\n    const dur = isHeavyMech ? 24 : 16;\n\n    if (this.stateTime === hitTime) {\n      // 判定伤及玩家\n      const range = isHeavyMech ? 90 : 65;\n      const reach = this.x + this.facing * 35;\n      if (Math.abs(reach - player.x) < range && Math.abs(this.y - player.y) < 50) {\n        const dmg = (isHeavyMech ? 28 : 16) * (this.limbs.weaponArm ? 1 : 0.4);\n        player.takeDamage(dmg, this.facing);\n      }\n    }\n\n    this.vx *= 0.85;\n\n    if (this.stateTime >= dur) {\n      this.state = 'chase';\n      this.atkCoolDown = isHeavyMech ? 90 : 50;\n    }\n  }\n\n  takeHit(damage, knockX, knockY, isHeavy, forceLimbBreak, isUppercut) {\n    this.hp -= damage;\n    this.poise -= damage * (isHeavy ? 2.5 : 1.2);\n    this.hurtTimer = isHeavy ? 20 : 12;\n    this.state = 'hurt';\n\n    this.vx = knockX;\n    this.vy = knockY;\n    addSpark(this.x, this.y - 35, '#ffaa00', 8, 4);\n\n    // 肢体破坏计算：强蓄力攻击、高连击积累或特定破韧性触发\n    if (forceLimbBreak || this.poise <= 0 || (isHeavy && Math.random() < 0.6)) {\n      this.breakNextLimb();\n      this.poise = this.maxPoise * 0.7; // 恢复部分韧性\n    }\n\n    if (this.hp <= 0 && !this.isDead) {\n      this.die();\n    }\n  }\n\n  breakNextLimb() {\n    // 优先顺序: 武器臂 -> 盾/副臂 -> 头部 -> 腿部\n    let target = null;\n    if (this.limbs.weaponArm) target = 'weaponArm';\n    else if (this.limbs.shieldArm) target = 'shieldArm';\n    else if (this.limbs.head) target = 'head';\n    else if (this.limbs.legs) target = 'legs';\n\n    if (target) {\n      this.limbs[target] = false;\n      totalBreaks++;\n      playSound('break');\n      triggerShake(10, 5);\n      // 生成飞溅肢体残骸物体\n      spawnLimbDebris(this.x, this.y - 35, target, this.type, this.facing);\n    }\n  }\n\n  die() {\n    this.isDead = true;\n    // 死亡爆体：剩下的所有部位一并飞裂\n    for (let part of ['head', 'weaponArm', 'shieldArm', 'legs']) {\n      if (this.limbs[part]) {\n        spawnLimbDebris(this.x, this.y - 35, part, this.type, this.facing);\n        this.limbs[part] = false;\n      }\n    }\n    addSpark(this.x, this.y - 35, '#ff4444', 24, 7);\n    playSound('hit_heavy');\n  }\n\n  draw(c) {\n    if (this.isDead) return;\n\n    c.save();\n    c.translate(this.x, this.y);\n    c.scale(this.facing, 1);\n\n    const isTelegraph = this.state === 'telegraph';\n    const isHurt = this.state === 'hurt';\n\n    // 蓄力前兆发红警示\n    if (isTelegraph) {\n      c.shadowColor = '#ff1144';\n      c.shadowBlur = 15;\n    }\n\n    // 阴影\n    c.fillStyle = 'rgba(0,0,0,0.3)';\n    c.beginPath();\n    c.ellipse(0, 0, this.type === 'brawler' ? 24 : 34, 8, 0, 0, Math.PI * 2);\n    c.fill();\n\n    const baseColor = this.type === 'brawler' ? '#3d485f' : '#4d3b3b';\n    const highlight = this.type === 'brawler' ? '#00e5ff' : '#ff5722';\n\n    // 1. 腿部绘制\n    if (this.limbs.legs) {\n      c.strokeStyle = baseColor;\n      c.lineWidth = this.type === 'brawler' ? 7 : 11;\n      c.lineCap = 'round';\n      const stride = (this.state === 'chase' && this.vx !== 0) ? Math.sin(this.stateTime * 0.3) * 12 : 0;\n      // 腿分段\n      c.beginPath();\n      c.moveTo(-6, -26);\n      c.lineTo(-10 - stride, -12);\n      c.lineTo(-8 - stride, 0);\n      c.stroke();\n\n      c.beginPath();\n      c.moveTo(6, -26);\n      c.lineTo(10 + stride, -12);\n      c.lineTo(12 + stride, 0);\n      c.stroke();\n    } else {\n      // 腿断后爬行姿态残桩冒火花\n      c.fillStyle = '#111';\n      c.fillRect(-6, -14, 12, 10);\n      if (Math.random() < 0.3) addSpark(this.x, this.y - 6, '#ffaa00', 1, 2);\n    }\n\n    // 2. 躯干\n    c.fillStyle = isHurt ? '#ffffff' : baseColor;\n    const bodyH = this.type === 'brawler' ? 32 : 44;\n    const bodyW = this.type === 'brawler' ? 22 : 36;\n    c.fillRect(-bodyW/2, -26 - bodyH, bodyW, bodyH);\n\n    // 核心指示灯\n    c.fillStyle = highlight;\n    c.fillRect(-4, -20 - bodyH/2, 8, 8);\n\n    // 3. 头部\n    if (this.limbs.head) {\n      c.fillStyle = '#1e2430';\n      const headY = -26 - bodyH - 12;\n      c.beginPath();\n      c.arc(0, headY, this.type === 'brawler' ? 10 : 15, 0, Math.PI*2);\n      c.fill();\n      // 单眼红/黄灯\n      c.fillStyle = isTelegraph ? '#ff0033' : highlight;\n      c.fillRect(3, headY - 3, 5, 4);\n    } else {\n      // 头部断裂截面断线电火花\n      if (Math.random() < 0.25) {\n        addSpark(this.x, this.y - bodyH - 26, '#00ffff', 2, 3);\n      }\n    }\n\n    // 4. 左臂 / 盾\n    if (this.limbs.shieldArm) {\n      c.strokeStyle = baseColor;\n      c.lineWidth = 6;\n      c.beginPath();\n      c.moveTo(-bodyW/4, -bodyH - 16);\n      c.lineTo(-bodyW/2 - 8, -bodyH);\n      c.lineTo(-bodyW/2 - 6, -24);\n      c.stroke();\n    }\n\n    // 5. 右臂 / 主武器\n    if (this.limbs.weaponArm) {\n      c.strokeStyle = '#232936';\n      c.lineWidth = 7;\n      c.beginPath();\n      const armSwing = this.state === 'attack' ? 20 : (isTelegraph ? -16 : 0);\n      c.moveTo(bodyW/4, -bodyH - 16);\n      c.lineTo(bodyW/2 + 8, -bodyH + armSwing);\n      c.lineTo(bodyW/2 + 18, -26 + armSwing * 1.5);\n      c.stroke();\n\n      // 武器主体（巨刃或机械锤）\n      c.fillStyle = highlight;\n      if (this.type === 'brawler') {\n        c.fillRect(bodyW/2 + 14, -40 + armSwing * 1.5, 8, 36);\n      } else {\n        c.fillRect(bodyW/2 + 12, -45 + armSwing * 1.5, 18, 22);\n      }\n    }\n\n    c.restore();\n\n    // 血条与韧性条悬浮显示\n    this.drawHealthBar(c);\n  }\n\n  drawHealthBar(c) {\n    const barW = this.type === 'brawler' ? 44 : 64;\n    const barH = 5;\n    const barX = this.x - barW / 2;\n    const barY = this.y - (this.type === 'brawler' ? 84 : 102);\n\n    c.fillStyle = 'rgba(0,0,0,0.6)';\n    c.fillRect(barX - 1, barY - 1, barW + 2, barH + 5);\n\n    // HP\n    const hpRatio = Math.max(0, this.hp / this.maxHp);\n    c.fillStyle = '#ff3366';\n    c.fillRect(barX, barY, barW * hpRatio, barH);\n\n    // 韧性条 (Poise)\n    const poiseRatio = Math.max(0, this.poise / this.maxPoise);\n    c.fillStyle = '#00d2ff';\n    c.fillRect(barX, barY + barH + 1, barW * poiseRatio, 2);\n  }\n}\n\n// 散落肢体实体（受力旋转、碰撞弹跳停在地表）\nfunction spawnLimbDebris(x, y, partName, enemyType, facing) {\n  const vx = (Math.random() - 0.5) * 8 - facing * 4;\n  const vy = -6 - Math.random() * 6;\n  const vRot = (Math.random() - 0.5) * 0.4;\n  flyingLimbs.push({\n    x, y, vx, vy, rot: 0, vRot,\n    partName, enemyType,\n    life: 180, // 存活一段时间淡出\n    isGrounded: false\n  });\n}\n\nfunction updateAndDrawDebris(c) {\n  for (let i = flyingLimbs.length - 1; i >= 0; i--) {\n    const d = flyingLimbs[i];\n    d.x += d.vx;\n    d.y += d.vy;\n    d.rot += d.vRot;\n\n    if (d.y < FLOOR_Y) {\n      d.vy += 0.8; // 重力\n    } else {\n      d.y = FLOOR_Y;\n      d.vy = -d.vy * 0.4; // 弹跳\n      d.vx *= 0.75;\n      d.vRot *= 0.6;\n      if (Math.abs(d.vy) < 1) {\n        d.vy = 0;\n        d.isGrounded = true;\n      }\n    }\n\n    d.life--;\n    if (d.life <= 0) {\n      flyingLimbs.splice(i, 1);\n      continue;\n    }\n\n    // 绘制残肢\n    c.save();\n    c.translate(d.x, d.y);\n    c.rotate(d.rot);\n    c.globalAlpha = Math.min(1, d.life / 30);\n    c.fillStyle = '#222834';\n    c.strokeStyle = '#ff3b30';\n\n    if (d.partName === 'head') {\n      c.beginPath();\n      c.arc(0, 0, 9, 0, Math.PI * 2);\n      c.fill();\n    } else if (d.partName === 'weaponArm') {\n      c.fillRect(-6, -4, 24, 8);\n      c.fillStyle = '#ff8800';\n      c.fillRect(10, -7, 10, 14);\n    } else if (d.partName === 'legs') {\n      c.lineWidth = 6;\n      c.beginPath();\n      c.moveTo(-6, -6); c.lineTo(0, 8); c.lineTo(8, 14);\n      c.stroke();\n    } else {\n      c.fillRect(-8, -8, 16, 12);\n    }\n\n    c.restore();\n  }\n}\n\n// ==================== 关卡与战斗波次管理 ====================\nlet player = new Player();\nlet enemies = [];\n\nfunction spawnWave(waveNum) {\n  enemies = [];\n  if (waveNum === 1) {\n    enemies.push(new Enemy(800, 'brawler'));\n    enemies.push(new Enemy(1050, 'brawler'));\n  } else if (waveNum === 2) {\n    enemies.push(new Enemy(850, 'juggernaut'));\n    enemies.push(new Enemy(1100, 'brawler'));\n  } else {\n    // 混合精英波\n    enemies.push(new Enemy(750, 'brawler'));\n    enemies.push(new Enemy(980, 'juggernaut'));\n    enemies.push(new Enemy(1180, 'brawler'));\n  }\n  document.getElementById('txt-wave').innerText = waveNum;\n}\n\nfunction onPlayerDeath() {\n  isGameOver = true;\n  document.getElementById('msg-title').innerText = \"战体损坏\";\n  document.getElementById('msg-title').style.color = \"#ff2a5f\";\n  document.getElementById('msg-desc').innerText = `击溃前线。共达成 ${totalHits} 命中，粉碎 ${totalBreaks} 个战体肢体。`;\n  document.getElementById('msg-overlay').style.display = 'block';\n}\n\nfunction resetGame() {\n  isGameOver = false;\n  player.reset();\n  currentWave = 1;\n  totalHits = 0;\n  totalBreaks = 0;\n  flyingLimbs.length = 0;\n  particles.length = 0;\n  slashFxList.length = 0;\n  document.getElementById('msg-overlay').style.display = 'none';\n  spawnWave(currentWave);\n}\n\n// ==================== 场景与背景渲染 ====================\nfunction drawBackground(c) {\n  // 深空远景渐变\n  const grad = c.createLinearGradient(0, 0, 0, H);\n  grad.addColorStop(0, '#0a0d16');\n  grad.addColorStop(0.7, '#151c2e');\n  grad.addColorStop(1, '#0b0e17');\n  c.fillStyle = grad;\n  c.fillRect(0, 0, W, H);\n\n  // 远景霓虹建筑轮廓\n  c.fillStyle = '#0f1422';\n  c.fillRect(80, 220, 120, 360);\n  c.fillRect(260, 280, 90, 300);\n  c.fillRect(600, 180, 160, 400);\n  c.fillRect(920, 250, 110, 330);\n  c.fillRect(1080, 310, 140, 270);\n\n  // 科技天桥与警告光条\n  c.strokeStyle = 'rgba(0, 229, 255, 0.15)';\n  c.lineWidth = 2;\n  c.beginPath();\n  c.moveTo(0, 360); c.lineTo(W, 360);\n  c.moveTo(0, 420); c.lineTo(W, 420);\n  c.stroke();\n\n  // 战斗平台地面\n  c.fillStyle = '#181f2f';\n  c.fillRect(0, FLOOR_Y, W, H - FLOOR_Y);\n\n  // 地面高亮边界光轨\n  const floorEdge = c.createLinearGradient(0, FLOOR_Y, W, FLOOR_Y);\n  floorEdge.addColorStop(0, '#00d2ff');\n  floorEdge.addColorStop(0.5, '#ff2a5f');\n  floorEdge.addColorStop(1, '#00d2ff');\n  c.strokeStyle = floorEdge;\n  c.lineWidth = 3;\n  c.beginPath();\n  c.moveTo(0, FLOOR_Y);\n  c.lineTo(W, FLOOR_Y);\n  c.stroke();\n\n  // 地面网格线\n  c.strokeStyle = 'rgba(255,255,255,0.04)';\n  c.lineWidth = 1;\n  for (let x = 0; x < W; x += 60) {\n    c.beginPath();\n    c.moveTo(x, FLOOR_Y);\n    c.lineTo(x - 80, H);\n    c.stroke();\n  }\n}\n\n// ==================== 特效与刀光更新 ====================\nfunction updateAndDrawEffects(c) {\n  // 刀光\n  for (let i = slashFxList.length - 1; i >= 0; i--) {\n    const s = slashFxList[i];\n    s.life++;\n    const progress = s.life / s.maxLife;\n    c.save();\n    c.translate(s.x, s.y);\n    c.scale(s.facing, 1);\n    c.beginPath();\n    c.arc(0, 0, s.radius, s.startAngle, s.endAngle, s.startAngle > s.endAngle);\n    c.strokeStyle = s.color;\n    c.lineWidth = s.width * (1 - progress);\n    c.shadowColor = s.color;\n    c.shadowBlur = 12;\n    c.stroke();\n    c.restore();\n\n    if (s.life >= s.maxLife) slashFxList.splice(i, 1);\n  }\n\n  // 粒子与残影\n  for (let i = particles.length - 1; i >= 0; i--) {\n    const p = particles[i];\n    p.life++;\n    p.x += p.vx;\n    p.y += p.vy;\n    const alpha = 1 - (p.life / p.maxLife);\n\n    if (p.ghost) {\n      // 玩家冲刺半透明残影\n      c.save();\n      c.translate(p.x, p.y);\n      c.scale(p.facing, 1);\n      c.globalAlpha = alpha * 0.45;\n      c.fillStyle = '#00f0ff';\n      c.fillRect(-10, -55, 20, 55);\n      c.restore();\n    } else {\n      c.save();\n      c.globalAlpha = alpha;\n      c.fillStyle = p.color;\n      c.beginPath();\n      c.arc(p.x, p.y, p.size, 0, Math.PI * 2);\n      c.fill();\n      c.restore();\n    }\n\n    if (p.life >= p.maxLife) particles.splice(i, 1);\n  }\n}\n\n// ==================== 主循环 ====================\nfunction gameLoop() {\n  // 命中顿帧逻辑：若处于顿帧中，跳过实体物理更新，仅重绘当前画面并消耗顿帧计时\n  if (hitStopTimer > 0) {\n    hitStopTimer--;\n  } else {\n    // 正常更新\n    if (!isGameOver) {\n      player.update();\n      for (let e of enemies) e.update();\n\n      // 检测波次刷新：全部消灭后快速进入下一波\n      const allDead = enemies.every(e => e.isDead);\n      if (allDead && enemies.length > 0) {\n        currentWave++;\n        spawnWave(currentWave);\n      }\n    }\n  }\n\n  // 屏幕震动偏移\n  let offsetX = 0;\n  let offsetY = 0;\n  if (shakeTimer > 0) {\n    shakeTimer--;\n    offsetX = (Math.random() - 0.5) * shakeIntensity * 2;\n    offsetY = (Math.random() - 0.5) * shakeIntensity * 2;\n  }\n\n  ctx.save();\n  ctx.translate(offsetX, offsetY);\n\n  // 渲染场景\n  drawBackground(ctx);\n\n  // 渲染掉落破碎肢体\n  updateAndDrawDebris(ctx);\n\n  // 渲染敌人\n  for (let e of enemies) e.draw(ctx);\n\n  // 渲染玩家\n  player.draw(ctx);\n\n  // 渲染刀光特效与粒子\n  updateAndDrawEffects(ctx);\n\n  ctx.restore();\n\n  // 更新HUD UI\n  document.getElementById('bar-hp').style.width = `${Math.max(0, (player.hp / player.maxHp) * 100)}%`;\n  document.getElementById('bar-sp').style.width = `${Math.max(0, (player.stamina / player.maxStamina) * 100)}%`;\n  document.getElementById('txt-combo').innerText = player.currentComboCount;\n  document.getElementById('txt-hits').innerText = totalHits;\n  document.getElementById('txt-breaks').innerText = totalBreaks;\n\n  requestAnimationFrame(gameLoop);\n}\n\n// 启动初始化\nspawnWave(1);\nrequestAnimationFrame(gameLoop);\n</script>\n</body>\n</html>",
