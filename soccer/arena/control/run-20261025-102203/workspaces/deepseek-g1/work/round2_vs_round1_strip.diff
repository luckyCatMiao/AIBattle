+def best_through_pass(st, u, opp, mates, me):
+    best = None
+    gx = OPP_GOAL_X[me]
+    for ai in range(0, 60):
+        if ai % 5 == 0 and not budget_left(1.6):
+            break
+        ang = (ai * 6.0) % 360.0
+        a = math.radians(ang)
+        ox = u.x + math.cos(a) * KICK_OFF
+        oy = u.y + math.sin(a) * KICK_OFF
+        if ball_hits_wall(ox, oy):
+            ox, oy = u.x, u.y
+        path, gf, gt = fly_path(ox, oy, ang)
+        if gf is not None:
+            if gt == me:
+                return (500.0, ang, 0, 0.0)
+            continue
+        if not path:
+            continue
+        opp_f = None
+        mate_f = None
+        mate = None
+        lim = min(len(path), 60)
+        for f in range(lim):
+            bx, by = path[f]
+            t = (f + 1) / float(HZ)
+            if opp_f is None:
+                for o in opp:
+                    if hyp(o.x - bx, o.y - by) <= CR + SPD * t:
+                        opp_f = f
+                        break
+            if mate_f is None:
+                for m in mates:
+                    if hyp(m.x - bx, m.y - by) <= CR + SPD * t:
+                        mate_f = f
+                        mate = m
+                        break
+            if opp_f is not None and mate_f is not None:
+                break
+        if mate_f is None:
+            continue
+        if opp_f is not None and opp_f <= mate_f:
+            continue
+        bx, by = path[mate_f]
+        prog = (bx - u.x) * ATK[me]
+        if prog < 4.0:
+            continue
+        if in_box(1 - me, bx, by):
+            continue
+        sc = 6.0 + prog * 0.32 + (40 - mate_f) * 0.05
+        sc += (30.0 - hyp(gx - bx, 13.0 - by)) * 0.03
+        if best is None or sc > best[0]:
+            best = (sc, ang, mate.index, (bx, by))
+    return best
+
