+def fly_path(bx, by, ang, maxf=140):
+    a = math.radians(ang)
+    vx, vy = KICKP * math.cos(a), KICKP * math.sin(a)
+    x, y = bx, by
+    path = []
+    for f in range(maxf):
+        for _ in range(4):
+            x += vx * DT / 4.0
+            y += vy * DT / 4.0
+            if in_goal_mouth(x, y):
+                if x <= 1.0:
+                    return path, f + 1, 1
+                if x >= W - 1.0:
+                    return path, f + 1, 0
+            if ball_hits_wall(x, y):
+                px, py = x - vx * DT / 4.0, y - vy * DT / 4.0
+                if ball_hits_wall(x, py):
+                    x = px
+                    vx = -vx * WALLR
+                if ball_hits_wall(px, y):
+                    y = py
+                    vy = -vy * WALLR
+                if ball_hits_wall(x, y):
+                    x, y = px, py
+                    vx = -vx * WALLR
+                    vy = -vy * WALLR
+        vx *= FRIC
+        vy *= FRIC
+        if abs(vx) + abs(vy) < 0.02:
+            vx = vy = 0.0
+        path.append((x, y))
+        if vx == 0.0 and vy == 0.0:
+            break
+    return path, None, -1
+
+
