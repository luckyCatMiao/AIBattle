# ==================== 凭据 / 私有数据（绝不提交） ====================
# data/state.json 里有对局凭据；players/ 是选手私有工作区。
data/
players/

# 早期 API 探针脚本：硬编码了真实 ANTHROPIC_AUTH_TOKEN。
# 想跑评测的人需要提供自己的 key（环境变量或 ~/.claude/settings.json）。
repro/
diag/scripts/drive.py

# 历史路径拼接 bug 在仓库根目录生成的目录：名称里是 U+F05C 转义符，
# 内含 bomber 选手的 .claude/settings.json 与真实 token。
/*aibattle-tools*

# ==================== 回放：全部游戏、全部 run 都保留 ====================
# 查看器实际读取的文件：
#   rts/hero-rts/bomber/fighting/defusal  run-*/status.json + r*-g*.json.gz
#   rts                                   run-*/replays.json
# 只排除重复的副本、模型 transcript 和工作区。

# 选手侧的回放副本（查看器读取 run 根目录的存档，这些是发给选手的重复文件）
**/public_replays.json
**/public-*.json.gz


# 说明：run-*/workspaces/ 与 run-*/round-*/ 下的策略代码保留；
# transcript（*.jsonl）、日志（*.log）和 __pycache__ 由下面的通用规则排除。

# control 根目录的临时状态、本机路径与日志
**/arena/control/.lock
**/arena/control/active-run.json
**/arena/control/clients.json
**/arena/control/engine-paths.json
**/arena/control/home-paths.json
**/arena/control/network-hosts
**/arena/control/status.json
**/arena/control/stream-proxy.json
**/arena/control/workspace-paths.json
**/arena/control/*.log

# ==================== 写作评测的生成目录 ====================
writing-bench/.venv/
writing-bench/runs/

# 击感实验室：保留可玩项目、评测 JSON 与关键试玩截图；
# 排除 transcript、Chrome 缓存、依赖、逐帧录屏与过程截图。
writing-bench/combat-runs/**/.chrome-cache/
writing-bench/combat-runs/**/node_modules/
writing-bench/combat-runs/**/.devtools/
writing-bench/combat-runs/**/.venv/
writing-bench/combat-runs/**/vendor/
writing-bench/combat-runs/**/*-sequence-*.png
writing-bench/combat-runs/**/skill-*.png
writing-bench/combat-runs/**/*.mp4
writing-bench/combat-runs/**/*.webm
writing-bench/combat-runs/**/*.mov
writing-bench/combat-runs/**/*.png
!writing-bench/combat-runs/**/sample-*.png

diag/runs/

# ==================== 日志 / 缓存 / 环境 ====================
*.log
*.jsonl
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.chrome-cache/
.DS_Store
Thumbs.db

# 发给选手的官方对局回放副本（run 根目录已有原档，工作区这份是重复的）
**/workspaces/**/matches/
# 选手自己导出的超大回放 dump（130MB+ 级别）
**/lab/**/*dump*.json
# 练习赛目录（黑盒自测产生，不属于系列赛记录）
**/arena/control/practice-*/
